  selectname: "\u201C\uB0A8\uC740 \uC77C\uC774 \uC880 \uC788\uC5B4\uC11C\u2026\u2026
    \uC774\uB9CC \uAC00\uBCFC\uAC8C.\u201D"
  th: 1
  iscorrect: 0
  selectedlog:
  - "#(\uB0B4 \uAC70\uC808\uC774 \uB5A8\uC5B4\uC9C0\uC790\uB9C8\uC790, \uC885\uB85C\uAD6C\uC758
    \uC5BC\uAD74\uC5D0 \uAE4A\uC740 \uC544\uC26C\uC6C0\uACFC \uC501\uC4F8\uD568\uC774
    \uAC00\uB4DD \uAE43\uB4E4\uC5C8\uB2E4.)  "
  - "#(\uD65C\uC9DD \uD53C\uC5B4\uB098\uB824\uB358 \uAF43\uC774 \uC21C\uC2DD\uAC04\uC5D0
    \uC2DC\uB4E4\uC5B4\uBC84\uB9AC\uB294 \uAC83\uB9CC \uAC19\uC558\uB2E4.) "
  - "\u201C\uC544, \uC608\u2026\u2026. \uC5ED\uC2DC \uC2DC\uC7A5\uB2D8\uC774\uC2DC\uB77C
    \uACF5\uBB34\uC5D0 \uC544\uC8FC \uCDA9\uC2E4\uD558\uC2DC\uB124\uC694. \uC77C
    \uB144 \uC0BC\uBC31\uC721\uC2ED\uC624\uC77C \uB0B4\uB0B4 \uC77C \uC0DD\uAC01\uBFD0\uC774\uC2E0\uAC00
    \uBD10\uC694.\u201D"
  - "\u201C\u2026\u2026\uC544, \uADF8\uB807\uAD70\uC694. \uBC14\uC058\uC2E0 \uBD84\uC744
    \uC81C\uAC00 \uAD1C\uD788 \uBD99\uC7A1\uC558\uB124\uC694. \uC54C\uACA0\uC2B5\uB2C8\uB2E4,
    \uC2DC\uC7A5\uB2D8. \uC870\uC2EC\uD788 \uB4E4\uC5B4\uAC00\uC138\uC694.\u201D"
  - "#(\uC885\uB85C\uAD6C\uC758 \uBAA9\uC18C\uB9AC\uC5D0\uB294 \uAC00\uB77C\uC549\uC740
    \uC544\uC26C\uC6C0\uC774 \uB69D\uB69D \uBB3B\uC5B4\uB0AC\uB2E4. \uADF8\uB140\uB294
    \uC5B5\uC9C0\uB85C \uBBF8\uC18C\uB97C \uC9C0\uC5B4 \uBCF4\uC774\uBA70 \uB098\uC5D0\uAC8C
    \uAC00\uBCCD\uAC8C \uBAA9\uB840\uB97C \uD588\uB2E4.) "
  - "#(\uADF8 \uD6C4\uB85C \uC885\uB85C\uAD6C\uC640 \uD5E4\uC5B4\uC838 \uD63C\uC790
    \uD130\uB35C\uD130\uB35C \uC2DC\uC7A5\uC2E4\uB85C \uB3CC\uC544\uAC00\uB294 \uAE38\uC744
    \uAC78\uC5C8\uB2E4.)"
  - "#(\uD145 \uBE48 \uAC70\uB9AC\uB97C \uAC77\uB2E4 \uBCF4\uB2C8 \uC774\uC0C1\uD558\uAC8C
    \uB9C8\uC74C \uD55C\uAD6C\uC11D\uC774 \uCC1D\uCC1D\uD558\uACE0 \uD5C8\uC804\uD588\uB2E4.)  "
  - "#(\uB300\uCCB4 \uBB50\uAC00 \uBB38\uC81C\uC600\uB358 \uAC78\uAE4C? \uADF8\uB140\uC758
    \uC2AC\uD508 \uB208\uB9DD\uC6B8\uC774 \uC790\uAFB8\uB9CC \uBA38\uB9BF\uC18D\uC744
    \uB9F4\uB3CC\uC544 \uBC1C\uAC78\uC74C\uC774 \uBB34\uAC70\uC6CC\uC84C\uB2E4.) "
