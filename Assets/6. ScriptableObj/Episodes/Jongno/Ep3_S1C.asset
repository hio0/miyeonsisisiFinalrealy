  selectname: "#(\uBC14\uB2E5\uC758 \uAE68\uC9C4 \uD30C\uD3B8\uC744 \uBB34\uC2DC\uD558\uACE0
    \uADF8\uB140\uC758 \uCC28\uAC11\uAC8C \uAD73\uC740 \uBEA8\uC744 \uB450 \uC190\uC73C\uB85C
    \uAC10\uC2F8 \uC950\uBA70 \uB208\uC744 \uB9DE\uCD94\uACE0)"
  th: 0
  iscorrect: 1
  selectedlog:
  - "\u201C\uC885\uB85C\uAD6C, \uB0A0\uCE74\uB85C\uC6B4 \uB9D0\uB85C \uC2A4\uC2A4\uB85C\uB97C
    \uCC0C\uB974\uC9C0 \uB9C8. \uB124\uAC00 \uC5BC\uB9C8\uB098 \uC544\uD508\uC9C0
    \uB2E4 \uBCF4\uC5EC. \uC228 \uD06C\uAC8C \uC26C\uC5B4.\u201D "
  - "#(\uB0B4\uAC00 \uADF8\uB140\uC758 \uC5BC\uAD74\uC744 \uAC15\uC81C\uB85C \uACE0\uC815\uD558\uACE0
    \uC628\uAE30\uB97C \uC804\uD558\uC790, \uC545\uC5D0 \uBC1B\uCCD0 \uB0A0\uC744
    \uC138\uC6B0\uB358 \uADF8\uB140\uC758 \uB208\uB3D9\uC790\uAC00 \uACA9\uB82C\uD558\uAC8C
    \uD754\uB4E4\uB9B0\uB2E4.) "
  - "#(\uC559\uB2E4\uBB3C\uACE0 \uC788\uB358 \uADF8\uB140\uC758 \uC785\uC220\uC774
    \uBBF8\uC138\uD558\uAC8C \uB5A8\uB9AC\uAE30 \uC2DC\uC791\uD55C\uB2E4.) "
  - " \u201C\u2026\u2026\uC774\uB7F0 \uC21C\uAC04\uAE4C\uC9C0 \uCC29\uD55C \uCC99\uC778\uAC00\uC694?
    \uC0AC\uB78C \uBE44\uCC38\uD558\uAC8C \uB9CC\uB4DC\uB294 \uB370\uB294 \uB3C4\uAC00
    \uD2B8\uC168\uB124\uC694. \""
  - "\"\uADF8\uB7F0\uB370\u2026\u2026 \uC65C \uC190\uC740 \uC774\uB807\uAC8C \uB530\uB73B\uD55C
    \uAC74\uB370\uC694\u2026\u2026?\u201D "
  - "#(\uADF8\uB140\uB294 \uB0B4 \uD488\uC5D0 \uC5BC\uAD74\uC744 \uBB3B\uACE0 \uC9D3\uB20C\uB9B0
    \uC6B8\uC74C\uC744 \uC0BC\uD0A8\uB2E4. \uD45C\uB3C5\uD558\uB358 \uAE30\uC138\uAC00
    \uC0AC\uADF8\uB77C\uB4E0\uB2E4.) "
