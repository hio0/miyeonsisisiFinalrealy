  selectname: "\u201C\uBB50\u2026\u2026 \uC77C \uB54C\uBB38\uC5D0 \uC654\uC5B4.\u201D "
  th: 0
  iscorrect: 0
  selectedlog:
  - "#\u201C\uB9D0\uC774 \uB108\uBB34 \uC9C0\uB098\uCE58\uAD70! \uD3C9\uC18C\uC758
    \uC720\uB2A5\uD558\uACE0 \uCC29\uD558\uB358 \uC885\uB85C\uAD6C\uB294 \uC5B4\uB514
    \uAC00\uACE0 \uC774\uB7F0 \uAD34\uBB3C\uC774 \uB41C \uAC74\uAC00!\u201D "
  - "#(\uB2E8\uD638\uD558\uAC8C \uCC45\uC0C1\uC744 \uB0B4\uB9AC\uCE58\uBA70 \uADF8\uB140\uC758
    \uD45C\uB3C5\uC2A4\uB7EC\uC6B4 \uD0DC\uB3C4\uB97C \uAFB8\uC9D6\uB294\uB2E4.)"
  - "#(\uC0C1\uD669\uC744 \uD1B5\uC81C\uD558\uAE30 \uC704\uD574 \uC774\uC131\uC801\uC73C\uB85C
    \uB2E4\uADF8\uCCE4\uC9C0\uB9CC, '\uCC29\uD55C \uBAA8\uC2B5'\uC744 \uAC15\uC694\uD558\uB294
    \uB0B4 \uD0DC\uB3C4\uAC00 \uADF8\uB140\uC758 \uC0C1\uCC98\uB97C \uC815\uD655\uD788
    \uCC14\uB800\uB2E4.) "
  - "\u201C\uAD34\uBB3C\u2026\u2026? \uC544\uD558, \uB4DC\uB514\uC5B4 \uBCF8\uC2EC\uC774
    \uB098\uC624\uC168\uB124\uC694. \uD3C9\uC18C\uC5D0 \uC58C\uC804\uD558\uAC8C \uC778\uD615\uCC98\uB7FC
    \uAD6C\uB2C8\uAE4C \uB0B4\uAC00 \uC26C\uC6CC \uBCF4\uC600\uB098 \uBCF4\uC8E0?\u201D"
  - "#(\uC885\uB85C\uAD6C\uB294 \uC2F8\uB298\uD558\uAC8C \uBE44\uC6C3\uC73C\uBA70
    \uCC45\uC0C1 \uC704\uC5D0 \uC788\uB358 \uB0B4 \uBA85\uD328\uB97C \uBC14\uB2E5\uC73C\uB85C
    \uC9D1\uC5B4\uB358\uC9C4\uB2E4.)"
  - "#(\uAE68\uC9C4 \uD50C\uB77C\uC2A4\uD2F1 \uC870\uAC01\uC774 \uC0AC\uBC29\uC73C\uB85C
    \uD280\uACE0,)"
  - "#(\uADF8\uB140\uC758 \uC548\uACBD \uB108\uBA38 \uB208\uBE5B\uC740 \uBA78\uC2DC\uC640
    \uC6D0\uB9DD\uC73C\uB85C \uAC00\uB4DD \uCC2C \uC2EC\uC5F0\uC73C\uB85C \uBCC0\uD574\uBC84\uB9B0\uB2E4.)  "
  - " \u201C\uCC29\uD55C \uC885\uB85C\uAD6C \uB530\uC708 \uCC98\uC74C\uBD80\uD130
    \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4. \uB2F9\uC2E0\uC774 \uB9CC\uB4E0 \uADF8 \uAC00\uC2DD\uC801\uC778
    \uAECD\uB370\uAE30 \uC544\uB798\uC11C \uB0B4\uAC00 \uC5BC\uB9C8\uB098 \uC369\uC5B4\uAC00\uACE0
    \uC788\uC5C8\uB294\uC9C0,\""
  - "\uD3C9\uC0DD \uBAA8\uB978 \uCC44 \uADF8\uB807\uAC8C \uC798\uB09C \uC2DC\uC7A5
    \uB178\uB987\uC774\uB098 \uD558\uC138\uC694!\u201D "
