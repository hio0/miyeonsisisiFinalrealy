  selectname: "(\uADF8\uB140\uC758 \uADF9\uB2E8\uC801\uC778 \uB3C5\uC810\uC695\uC744
    \uC21C\uC885\uC801\uC73C\uB85C \uBC1B\uC544\uB4E4\uC774\uBA70 \uBBF8\uC18C \uC9D3\uB294\uB2E4.)  "
  th: 1
  iscorrect: 1
  selectedlog:
  - "#\u201C\u2026\u2026\uC6D0\uD55C\uB2E4\uBA74 \uADF8\uB807\uAC8C \uD574. \uB124
    \uC190\uC5D0 \uC2DC\uB825\uC744 \uC783\uC5B4\uB3C4 \uC88B\uC73C\uB2C8, \uAE30\uAEBC\uC774
    \uB124 \uAD6C\uC18D\uC744 \uBC1B\uACA0\uB2E4.\u201D "
  - "#(\uADF8\uB140\uC758 \uADF9\uB2E8\uC801\uC778 \uB3C5\uC810\uC695\uC744 \uC21C\uC885\uC801\uC73C\uB85C
    \uBC1B\uC544\uB4E4\uC774\uBA70 \uBBF8\uC18C \uC9D3\uB294\uB2E4.)  "
  - "#(\uC790\uC2E0\uC744 \uC704\uD574 \uAE30\uAEBC\uC774 \uB9DD\uAC00\uC9C0\uACA0\uB2E4\uB294
    \uC120\uC5B8\uC744 \uB4E3\uC790, \uC885\uB85C\uAD6C\uC758 \uD45C\uB3C5\uC2A4\uB7FD\uB358
    \uC5BC\uAD74\uC774 \uC21C\uAC04 \uBBFF\uC744 \uC218 \uC5C6\uB2E4\uB294 \uB4EF\uD55C
    \uD669\uD640\uAC10\uC73C\uB85C \uBB3C\uB4E0\uB2E4. )"
  - "\uADF8\uB140\uAC00 \uD53C \uBB3B\uC740 \uC190\uC73C\uB85C \uB0B4 \uBAA9\uC744
    \uAC10\uC2F8 \uC548\uC73C\uBA70 \uBBF8\uCE5C \uB4EF\uC774 \uC6C3\uC5B4\uB304\uB2E4.) "
  - "\u201C\uC544\uD558\uD558\u2026\u2026 \uC9C4\uC9DC\uC9C0? \uAC70\uC9D3\uB9D0\uC774\uBA74
    \uB2F9\uC2E0 \uC2EC\uC7A5\uC744 \uD30C\uB0B4\uBC84\uB9B4 \uAC70\uC57C.\""
  - "\"\uB9DE\uC544, \uC6B0\uB9B0 \uC774\uB807\uAC8C \uC11C\uB85C\uB97C \uD30C\uAD34\uD558\uBA74\uC11C
    \uC601\uC6D0\uD788 \uD568\uAED8\uD558\uB294 \uAC70\uC57C. \uB108\uBB34\uB098
    \uC644\uBCBD\uD55C \uACB0\uB9D0\uC774\uB124, \uC2DC\uC7A5\uB2D8.\u201D"
  - "#(\uC704\uAE30\uB294 \uB118\uACBC\uC9C0\uB9CC, \uB0B4 \uBAA9\uB35C\uBBF8\uB97C
    \uD30C\uACE0\uB4DC\uB294 \uADF8\uB140\uC758 \uC190\uD1B1\uACFC \uC0B4\uAE30 \uC5B4\uB9B0
    \uB208\uBE5B\uC740 \uBC29\uC548\uC758 \uACF5\uAE30\uB97C \uC228 \uB9C9\uD788\uAC8C
    \uB9CC\uB4E0\uB2E4.)  "
