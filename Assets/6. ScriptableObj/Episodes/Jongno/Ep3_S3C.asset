  selectname: "\u201C\uAC00\uC2A4\uAC00 \uD130\uC9C0\uB4E0 \uC2DC\uCCAD\uC774 \uB0A0\uC544\uAC00\uB4E0
    \uB9D8\uB300\uB85C \uD574. \uB09C \uC5EC\uAE30\uC11C \uD55C \uBC1C\uC9DD\uB3C4
    \uC548 \uC6C0\uC9C1\uC5EC.\u201D"
  th: 1
  iscorrect: 1
  selectedlog:
  - "#(\uADF8\uB140\uAC00 \uB4E0 \uC6D0\uACA9 \uC7A5\uCE58\uC758 \uC548\uD14C\uB098\uB97C
    \uB9E8\uC190\uC73C\uB85C \uAEBE\uC5B4\uBC84\uB9AC\uBA70 \uBD80\uC11C\uC9C4 \uB0A0\uCE74\uB85C\uC6B4
    \uBD80\uD488\uC5D0 \uC190\uC744 \uBCA0\uC774\uBA74\uC11C) "
  - "#(\uB0B4\uAC00 \uC8FC\uC800 \uC5C6\uC774 \uC7A5\uCE58\uB97C \uB9DD\uAC00\uB728\uB9AC\uBA70
    \uD53C\uB97C \uD758\uB9AC\uC790, \uC5B8\uC81C\uB098 \uC644\uBCBD\uD55C \uD30C\uBA78\uC744
    \uBC14\uB790\uB358 \uC885\uB85C\uAD6C\uAC00 \uCDA9\uACA9\uC744 \uBC1B\uC740 \uB4EF
    \uC7A5\uCE58\uB97C \uB5A8\uC5B4\uB728\uB9B0\uB2E4.)  "
  - "#(\uCF85 \uD558\uB294 \uC18C\uB9AC\uC640 \uD568\uAED8 \uBB38\uC774 \uBD80\uC11C\uC9C0\uBA70
    \uACBD\uBE44 \uC694\uC6D0\uB4E4\uC774 \uBC29\uC548\uC73C\uB85C \uB4E4\uC774\uB2E5\uCE5C\uB2E4.
    \uCCB4\uD3EC\uB418\uAE30 \uC9C1\uC804\uC758 \uCC30\uB098,)"
  - "#(\uADF8\uB140\uB294 \uB0B4 \uD758\uB7EC\uB0B4\uB9AC\uB294 \uD53C\uB97C \uBA4D\uD558\uB2C8
    \uBC14\uB77C\uBCF4\uB354\uB2C8 \uAD74\uBCF5\uACFC \uD328\uBC30\uAC00 \uC11E\uC778
    \uBE44\uCC38\uD558\uACE0\uB3C4 \uC560\uC808\uD55C \uBBF8\uC18C\uB97C \uC9C0\uC5B4
    \uBCF4\uC778\uB2E4.)  "
  - "\u201C\u2026\u2026\uB2F9\uC2E0\uC740 \uC815\uB9D0 \uC9C0\uB3C5\uD55C \uC545\uB9C8\uC608\uC694,
    \uC2DC\uC7A5\uB2D8. \""
  - "\"\uB0B4 \uB3C5\uC124\uB3C4, \uAD11\uAE30\uB3C4 \uC804\uBD80 \uBE44\uC6C3\uB4EF\uC774
    \uBC1B\uC544\uB0B4\uB2E4\uB2C8\u2026\u2026 \uC774\uC81C \uB09C \uD3C9\uC0DD \uB2F9\uC2E0
    \uC5C6\uC778 \uC0B4 \uC218 \uC5C6\uAC8C \uB418\uC5C8\uC796\uC544\u2026\u2026.\u201D "
