  selectname: " \u201C\uBB34\uC2A8 \uC77C \uC788\uB294\uC9C0 \uB9D0\uD574 \uBD10.
    \uB4E4\uC5B4\uC904\uAC8C.\u201D "
  th: 0
  iscorrect: 1
  selectedlog:
  - "`# \uADF8 \uB9D0 \uC9C1\uD6C4 \uC885\uB85C\uB294 \uD130\uC9C4 \uB9D0\uC744 \uD130\uD2B8\uB9AC\uB4EF
    \uC774\uD574\uD560 \uC218 \uC5C6\uC744 \uC815\uB3C4\uB85C \uBE60\uB978 \uC18D\uB3C4\uB85C
    \uB9D0\uC744 \uBC49\uC5B4\uB0C8\uB2E4."
  - "\"\uC2DC\uC7A5\uB2D8\uC694\uC998\uC81C\uAC00\uC228\uC744\uC26C\uB294\uAC83\uB3C4\uC774\uACF3\uC5D0\uC11C\uC6C0\uC9C1\uC774\uB294\uAC83\uB3C4\uACE0\uD1B5\uC758\uBC18\uBCF5\uC774\uC5D0\uC694\uC810\uCC28\uC774\uD574\uD560\uC218\uC5C6\uB294\uC0C1\uD669\uC774\uB2E4\uAC00\uC624\uACE0\uC9C0\uAE08\uB3CC\uC544\uAC00\uB294\uC774\uACF3\uC740...\uD558\uC544...\""
  - "`# \uADF8\uB807\uAC8C \uB9D0\uC744 \uD1A0\uD574\uB0B4\uACE0 \uB098\uC11C\uC57C
    \uADF8\uB098\uB9C8 \uB098\uC544\uC84C\uB294 \uC9C0 \uC228\uC744 \uB0B4\uC26C\uB294
    \uADF8\uB140\uB294 \uD5C8\uB355\uC774\uBA70 \uC6C3\uB294\uB2E4."
  - "\"....\uACE0\uB9C8\uC6CC\uC694.. \uB4E4\uC5B4\uC918\uC11C\uC694..\""
  - "\uADF8\uB140\uC758 \uC5BC\uAD74\uC5D0\uB294 \uC6C3\uC74C\uC774 \uBB3B\uC5B4\uB09C\uB2E4."
