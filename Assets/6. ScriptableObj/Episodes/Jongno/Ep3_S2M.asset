  selectname: "\u201C\uBBF8\uCCE4\uAD70, \uAC10\uD788 \uB204\uAD6C\uC5D0\uAC8C \uC190\uC744
    \uB300\uB294 \uAC74\uAC00! \uB2F9\uC7A5 \uADF8 \uB354\uB7EC\uC6B4 \uC190 \uCE58\uC6CC!\u201D"
  th: 1
  iscorrect: 0
  selectedlog:
  - "#(\uADF8\uB140\uC758 \uC190\uBAA9\uC744 \uAC70\uCE60\uAC8C \uB0B4\uCE58\uACE0
    \uB4A4\uB85C \uBB3C\uB7EC\uC11C\uBA70 \uC120\uC744 \uAE0B\uB294\uB2E4.) \t "
  - "#(\uADF8\uB140\uC758 \uAC00\uD559\uC801\uC778 \uD589\uB3D9\uC744 \uAC15\uD558\uAC8C
    \uAC70\uBD80\uD558\uC790, \uADF8\uAC83\uC774 \uADF8\uB140\uC758 \uC5B5\uB20C\uB9B0
    \uD53C\uD574\uC758\uC2DD\uC744 \uC644\uC804\uD788 \uD3ED\uBC1C\uC2DC\uCF30\uB2E4.) "
  - " \u201C\uB354\uB7EC\uC6B4 \uC190\u2026\u2026? \uB0B4\uAC00 \uB2F9\uC2E0\uC744
    \uC704\uD574 \uBC14\uCE5C \uB0A0\uC774 \uBA70\uCE60\uC778\uB370, \uC774\uC81C
    \uC640\uC11C \uB0A0 \uBD88\uACB0\uD55C \uC624\uBB3C \uCDE8\uAE09\uC744 \uD574?!\u201D "
  - "#(\uADF8\uB140\uB294 \uB2E8\uC228\uC5D0 \uAC70\uB9AC\uB97C \uC881\uD600\uC624\uBA70
    \uAE68\uC9C4 \uB3C4\uC790\uAE30 \uD30C\uD3B8\uC73C\uB85C \uB0B4 \uBAA9\uC744
    \uAC15\uD558\uAC8C \uACA8\uB208\uB2E4. )"
  - "#( \uB0A0\uCE74\uB85C\uC6B4 \uB2E8\uBA74\uC774 \uC0B4\uAC17\uC744 \uD30C\uACE0\uB4E4\uBA70
    \uD54F\uBC29\uC6B8\uC774 \uB9FA\uD78C\uB2E4. \uADF8\uB140\uC758 \uB208\uC5D0\uC11C
    \uC99D\uC624 \uC5B4\uB9B0 \uB208\uBB3C\uC774 \uC3DF\uC544\uC9C4\uB2E4.) "
  - " \u201C\uB0A0 \uBC84\uB9AC\uACE0 \uAC08 \uC0DD\uAC01\uB9CC \uAC00\uB4DD\uD558\uB2E4\uBA74,
    \uCC28\uB77C\uB9AC \uC774 \uB0A0\uCE74\uB85C\uC6B4 \uD30C\uD3B8\uC73C\uB85C \uB2F9\uC2E0
    \uBAA9\uD1B5\uC744 \uB6AB\uC5B4\uBC84\uB9AC\uACA0\uC5B4! \uB0B4\uAC00 \uBABB
    \uAC00\uC9C8 \uBC14\uC5D4 \uC544\uBB34\uB3C4 \uBABB \uAC00\uC838!\u201D "
