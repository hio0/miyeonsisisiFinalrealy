  selectname: "\u201C\uADF8\uB0E5 \uB108 \uBCF4\uB7EC \uC654\uC5B4.\u201D"
  th: 0
  iscorrect: 1
  selectedlog:
  - "#(\uADF8 \uB9D0 \uD55C\uB9C8\uB514\uC5D0, \uD3C9\uC18C\uC5D0\uB3C4 \uB298 \uCC28\uBD84\uD55C
    \uBBF8\uC18C\uB97C \uC720\uC9C0\uD558\uB358 \uC885\uB85C\uAD6C\uC758 \uC5BC\uAD74\uC5D0
    \uD654\uC0AC\uD55C \uAF43\uC774 \uD53C\uC5B4\uB098\uB4EF \uBC1D\uC544\uC84C\uB2E4.)"
  - "#( \uD558\uC580 \uBEA8\uC774 \uC21C\uC2DD\uAC04\uC5D0 \uBD89\uAC8C \uBB3C\uB4DC\uB294
    \uAC83\uC774 \uC2E4\uC2DC\uAC04\uC73C\uB85C \uBCF4\uC600\uB2E4.)"
  - "\u201C\u2026\u2026\uC9C0, \uC9C4\uC9DC\uB85C\uC694? \uC5C5\uBB34 \uB54C\uBB38\uC774
    \uC544\uB2C8\uB77C\u2026\u2026?\u201D"
  - "#(\uB2F9\uD669\uD55C \uB4EF \uC2DC\uC120\uC744 \uC774\uB9AC\uC800\uB9AC \uAD74\uB9AC\uB358
    \uADF8\uB140\uB294 \uC774\uB0B4 \uACE0\uAC1C\uB97C \uD479 \uC219\uC774\uBA70
    \uC81C \uC637\uC790\uB77D\uC744 \uB9CC\uC9C0\uC791\uAC70\uB838\uB2E4.) "
  - " \u201C\u2026\u2026\uACE0\uB9C8\uC6CC\uC694, \uC2DC\uC7A5\uB2D8.\u201D"
  - "#(\uBAA8\uAE30\uB9CC \uD55C \uC18C\uB9AC\uB85C \uC791\uAC8C \uACE0\uB9D9\uB2E4\uB294
    \uB9D0\uC744 \uC804\uD558\uB294 \uADF8\uB140\uC758 \uBAA9\uC18C\uB9AC\uC5D0\uB294,
    \uC228\uAE30\uB824 \uD574\uB3C4 \uC228\uACA8\uC9C0\uC9C0 \uC54A\uB294 \uC124\uB818\uACFC
    \uBD80\uB044\uB7EC\uC6C0\uC774 \uAC00\uB4DD \uAE43\uB4E4\uC5B4 \uC788\uC5C8\uB2E4.)"
  - "#(\uADF8 \uBC18\uC751\uC774 \uAF64\uB098 \uADC0\uC5EC\uC6CC \uB098\uB3C4 \uBAA8\uB974\uAC8C
    \uBBF8\uC18C\uB97C \uC9C0\uC5C8\uB2E4.)"
