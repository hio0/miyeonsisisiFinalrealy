  m_Script: {fileID: 11500000, guid: d86ef726ec2bb1340be9fc0a470d9b84, type: 3}
  m_Name: jsEpisode2
  m_EditorClassIdentifier: 
  texts:
  - "`#(\uC11C\uC6B8 \uC2DC\uC7A5\uC73C\uB85C \uBD80\uC784\uD55C \uC9C0 \uC5B4\uB290\uB367
    \uBA87 \uC8FC\uAC00 \uC9C0\uB0AC\uB2E4.)"
  - "`# (\uB9E4\uC77C\uAC19\uC774 \uC3DF\uC544\uC9C0\uB294 \uACB0\uC7AC \uC11C\uB958\uC5D0
    \uD30C\uBB3B\uD600 \uC9C0\uB0B4\uB2E4,)"
  - "`# (\uBA38\uB9AC\uB3C4 \uC2DD\uD788\uACE0 \uAD00\uB0B4 \uC0C1\uD669\uB3C4 \uC9C1\uC811
    \uD655\uC778\uD560 \uACB8 \uB098\uC120 \uC11C\uC6B8 \uAC70\uB9AC \uC21C\uCC30\uAE38.)"
  - "`# (\uACE0\uD48D\uC2A4\uB7EC\uC6B4 \uD55C\uC625\uACFC \uD604\uB300\uC801\uC778
    \uBE4C\uB529\uC774 \uAE30\uBB18\uD558\uAC8C \uC5B4\uC6B0\uB7EC\uC9C4 \uAC70\uB9AC\uB97C
    \uAC77\uACE0 \uC788\uC744 \uB54C\uC600\uB2E4.) "
  - "[surprised]\u201C\uC5B4\uB77C? \uC2DC\uC7A5\uB2D8? \uC5EC\uAE30\uB294 \uBB34\uC2A8
    \uC77C\uC774\uC138\uC694?\u201D"
  - "`#(\uB4A4\uB97C \uB3CC\uC544\uBCF4\uC790, \uC775\uC219\uD55C \uB178\uB780\uC0C9
    \uB54B\uC740 \uBA38\uB9AC\uB97C \uD754\uB4E4\uBA70 \uC885\uB85C\uAD6C\uAC00 \uB2E4\uAC00\uC640
    \uC778\uC0AC\uB97C \uB358\uC84C\uB2E4.)"
  - "`#(\uD3C9\uC18C\uCC98\uB7FC \uB2E8\uC815\uD558\uBA74\uC11C\uB3C4 \uC5B4\uB518\uAC00
    \uBAA8\uB974\uAC8C \uC0AC\uB78C\uC744 \uC774\uB044\uB294 \uC544\uC6B0\uB77C\uB97C
    \uD48D\uAE30\uB294 \uADF8\uB140\uC600\uB2E4.)"
  - "`*#(\uBB50\uB77C\uACE0 \uB2F5\uD558\uB294 \uAC83\uC774 \uC88B\uC744\uAE4C?) "
  - "`#(\uC5B4\uC0C9\uD55C \uAE30\uB958\uB97C \uAE68\uB824\uB294 \uB4EF, \uC885\uB85C\uAD6C\uAC00
    \uD07C\uD07C, \uD558\uACE0 \uD5DB\uAE30\uCE68\uC744 \uD558\uBA70 \uB300\uD654\uC758
    \uC6B4\uC744 \uB744\uC6E0\uB2E4.) "
  - "[happy]\u201C\uC554\uD2BC\u2026\u2026 \uADF8\uB798\uB3C4 \uC2DC\uC7A5\uB2D8\uC774
    \uB2E4\uB978 \uB3D9\uC0DD\uB4E4\uACFC\uB3C4 \uC0AC\uC774\uC88B\uAC8C \uC9C0\uB0B4\uC2DC\uB294
    \uAC83 \uAC19\uC544\uC11C \uB2E4\uD589\uC774\uC5D0\uC694.\u201D "
  - "\u201C\uB2E4\uB4E4 \uAC89\uC73C\uB85C\uB294 \uBA40\uCA61\uD574 \uBCF4\uC5EC\uB3C4\u2026\u2026\u201D "
  - "\u201C \uC800\uB9C8\uB2E4 \uB9C8\uC74C\uC5D0 \uCEE4\uB2E4\uB780 \uBCD1\uC744
    \uD558\uB098\uC529\uC740 \uD488\uACE0 \uC788\uB294 \uC544\uC774\uB4E4\uC774\uB77C
    \uAC71\uC815\uC774 \uB9CE\uC558\uAC70\uB4E0\uC694.\u201D"
  - "`#\u2026\u2026\uB0B4\uAC00 \uBCF4\uAE30\uC5D4 \uB108\uB3C4 \uB9CC\uB9CC\uCE58
    \uC54A\uAC8C \uC815\uC0C1\uC740 \uC544\uB2CC \uAC83 \uAC19\uB2E4\uB9CC.\u2019"
  - "`#(\uB9C8\uC74C\uC18D\uC73C\uB85C\uB9CC \uC0BC\uD0A8 \uB9D0\uC744 \uC544\uB294\uC9C0
    \uBAA8\uB974\uB294\uC9C0, \uC885\uB85C\uAD6C\uB294 \uC190\uBF09\uC744 \uC9DD
    \uCE58\uBA70 \uB098\uB97C \uC62C\uB824\uB2E4\uBCF4\uC558\uB2E4.) "
  - "`#(\uADF8\uB140\uC758 \uB9D1\uC740 \uB208\uB3D9\uC790\uAC00 \uB208\uC5D0 \uB744\uAC8C
    \uBC18\uC9DD\uC774\uAE30 \uC2DC\uC791\uD588\uB2E4.) "
  - "[happy] \u201C\uC88B\uC544\uC694! \uB9C8\uCE68 \uC774\uB807\uAC8C \uB9CC\uB09C
    \uAC83\uB3C4 \uC778\uC5F0\uC778\uB370, \uC624\uB298\uC740 \uC81C\uAC00 \uC9C1\uC811
    \uC81C \uAD6C\uC5ED\uC744 \uC18C\uAC1C\uC2DC\uCF1C \uB4DC\uB9AC\uC8E0! \uC804\uD1B5\uACFC
    \uC5ED\uC0AC\uAC00 \uC0B4\uC544 \uC228 \uC26C\uB294 \uC9C4\uC9DC \u2018\uC885\uB85C\uAD6C\u2019\uB97C\uC694!\u201D "
  - "`#(\uB098\uB97C \uBC14\uB77C\uBCF4\uB294 \uADF8\uB140\uC758 \uB208\uB3D9\uC790\uC5D0\uB294
    \uC5B4\uB9B0\uC544\uC774\uCC98\uB7FC \uB4E4\uB728\uACE0 \uC124\uB808\uB294 \uB9C8\uC74C\uC774
    \uD22C\uBA85\uD558\uAC8C \uB2F4\uACA8 \uC788\uC5C8\uB2E4. \uAC70\uC808\uD558\uAE30
    \uD798\uB4E4 \uB9CC\uD07C \uB9E4\uB825\uC801\uC778 \uC81C\uC548\uC774\uC5C8\uB2E4.) "
  - "`*#(\uBB34\uC2A8 \uB2F5\uC744 \uD574\uC8FC\uC5B4\uC57C\uD560\uAE4C?) "
  selects:
