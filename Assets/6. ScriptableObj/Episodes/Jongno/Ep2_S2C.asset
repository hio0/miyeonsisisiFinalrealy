  selectname: "\u201C\uC7A0\uAE50\uB9CC\uC774\uB2E4? \uADF8\uB7FC \uC88B\uC544. \uC548\uB0B4\uD574
    \uC918.\u201D "
  th: 1
  iscorrect: 1
  selectedlog:
  - "\u201C\uB2F9\uC5F0\uD558\uC8E0! \uC800\uB9CC \uBBFF\uACE0 \uB530\uB77C\uC624\uC138\uC694!\u201D "
  - "#(\uAE30\uB2E4\uB838\uB2E4\uB294 \uB4EF \uB0B4 \uC18C\uB9E4\uB97C \uBD99\uC7A1\uC544
    \uC774\uB044\uB294 \uADF8\uB140\uC758 \uC190\uAE38\uC5D0 \uC774\uB04C\uB824,
    \uC6B0\uB9AC\uB294 \uBCF8\uACA9\uC801\uC778 \uC885\uB85C \uAC70\uB9AC\uB97C \uAC77\uAE30
    \uC2DC\uC791\uD588\uB2E4.)  "
  - "#(\uACE0\uC988\uB109\uD55C \uB3CC\uB2F4\uAE38\uC744 \uB530\uB77C \uAC78\uC73C\uBA70
    \uC5ED\uC0AC \uC774\uC57C\uAE30\uB97C \uB4E4\uB824\uC8FC\uAE30\uB3C4 \uD558\uACE0,
    \uC778\uC0AC\uB3D9\uC758 \uCC3B\uC9D1\uC5D0 \uB4E4\uB7EC \uC309\uC2F8\uB984\uD55C
    \uC804\uD1B5\uCC28\uB97C \uB9C8\uC2DC\uAE30\uB3C4 \uD588\uB2E4.)  "
  - "#(\uC2DC\uC7A5\uC2E4\uC5D0\uC11C\uC758 \uB531\uB531\uD55C \uBAA8\uC2B5\uC740
    \uC628\uB370\uAC04\uB370\uC5C6\uACE0, \uB0B4 \uB9AC\uC561\uC158 \uD558\uB098\uD558\uB098\uC5D0
    \uC544\uC774\uCC98\uB7FC \uD658\uD558\uAC8C \uC6C3\uB294 \uADF8\uB140\uC758 \uC0C8\uB85C\uC6B4
    \uBA74\uBAA8\uB97C \uBC1C\uACAC\uD560 \uC218 \uC788\uC5C8\uB2E4.) "
  - " \u201C\u2026\u2026\uACE0\uB9C8\uC6CC\uC694, \uC2DC\uC7A5\uB2D8.\u201D"
  - "\u201C\uD558\uD558\uD558\uD558! \uC2DC\uC7A5\uB2D8, \uBC29\uAE08 \uADF8 \uD45C\uC815
    \uC9C4\uC9DC \uC6C3\uACBC\uC5B4\uC694! \uC544, \uC815\uB9D0 \uC624\uB79C\uB9CC\uC5D0
    \uC774\uB807\uAC8C \uC18C\uB9AC \uB0B4\uC11C \uC6C3\uC5B4\uBCF4\uB124\uC694.\u201D"
  - "#(\uB178\uC744\uBE5B\uC744 \uBC1B\uC544 \uD669\uAE08\uBE5B\uC73C\uB85C \uBE5B\uB098\uB294
    \uADF8\uB140\uC758 \uC5BC\uAD74\uC5D0\uB294 \uADF8 \uC5B4\uB5A4 \uAC00\uC2DD\uB3C4
    \uC5C6\uB294 \uC21C\uC218\uD55C \uC6C3\uC74C\uC774 \uD53C\uC5B4\uB0AC\uB2E4.) "
  - "#(\uB2E8 \uD558\uB098\uB3C4 \uBE60\uC9D0\uC5C6\uC774 \uC990\uAC81\uACE0, \uAC00\uC2B4\uC774
    \uAC04\uC9C0\uB7EC\uC6CC\uC9C0\uB294 \uC2DC\uAC04\uC774\uC5C8\uB2E4.)"
