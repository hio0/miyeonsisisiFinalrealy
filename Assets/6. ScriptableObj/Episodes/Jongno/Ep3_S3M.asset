  selectname: "\u201C\uBE44\uC11C\uC2E4! \uB2F9\uC7A5 \uBB38 \uBD80\uC218\uACE0 \uB4E4\uC5B4\uC640\uC11C
    \uC774 \uC815\uC2E0 \uB098\uAC04 \uB144\uC744 \uC81C\uC555\uD574\uB77C!\u201D"
  th: 1
  iscorrect: 0
  selectedlog:
  - "#(\uC778\uD130\uD3F0\uACFC \uBB38\uC744 \uD5A5\uD574 \uBAA9\uC774 \uD130\uC838\uB77C
    \uBE44\uBA85\uC744 \uC9C0\uB974\uBA70 \uB3C4\uC6C0\uC744 \uC694\uCCAD\uD55C\uB2E4.) "
  - "#(\uBE44\uBA85\uC744 \uB4E4\uC740 \uBCF4\uC548 \uC694\uC6D0\uB4E4\uC774 \uB3C4\uB07C\uB85C
    \uBB38\uC744 \uBD80\uC218\uACE0 \uC21C\uC2DD\uAC04\uC5D0 \uC9C4\uC785\uD574 \uADF8\uB140\uB97C
    \uBC14\uB2E5\uC5D0 \uAC70\uCE60\uAC8C \uBA54\uCE58\uACE0 \uC218\uAC11\uC744 \uCC44\uC6B4\uB2E4.)"
  - "#(\uACBD\uBE44\uB4E4\uC5D0\uAC8C \uB20C\uB824 \uC5BC\uAD74\uC774 \uBC14\uB2E5\uC5D0
    \uC9D3\uBC15\uD788\uB294 \uC640\uC911\uC5D0\uB3C4, )"
  - "#(\uC885\uB85C\uAD6C\uB294 \uD750\uD2B8\uB7EC\uC838 \uAE68\uC9C4 \uC548\uACBD
    \uB108\uBA38\uB85C \uD53C\uB208\uBB3C\uC774 \uD750\uB97C \uB4EF\uD55C \uD45C\uB3C5\uC2A4\uB7EC\uC6B4
    \uC2DC\uC120\uC73C\uB85C \uB098\uB97C \uB178\uB824\uBCF8\uB2E4.) "
  - "\u201C\uB0A8\uC758 \uC190\uC744 \uBE4C\uB824 \uB098\uB97C \uBBF8\uCE5C\uB144
    \uCDE8\uAE09\uD558\uBA70 \uCAD3\uC544\uB0B4? \uB611\uB611\uD788 \uAE30\uC5B5\uD574
    \uB46C, \uC2DC\uC7A5.\""
  - "\"\uB124\uB188\uC774 \uB0B4\uBBFC \uADF8 \uC54C\uB7C9\uD55C \uC704\uC120\uACFC
    \uACF5\uBB34\uC758 \uB300\uAC00\uB294\u2026\u2026 \uB124\uB188\uC758 \uBAA9\uC228\uC73C\uB85C
    \uBC1B\uC73C\uB7EC \uC62C \uD14C\uB2C8\uAE4C.\u201D  "
  - "#(\uADF8\uB140\uB294 \uC694\uC6D0\uB4E4\uC5D0\uAC8C \uACB0\uBC15\uB2F9\uD55C
    \uCC44 \uC9C0\uD558 \uACA9\uB9AC\uC2E4\uB85C \uC555\uC1A1\uB418\uC5B4 \uAC00\uACE0,
    )"
  - "#(\uC9D1\uBB34\uC2E4 \uB0B4\uBD80\uC5D0\uB294 \uADF8\uB140\uAC00 \uBC49\uC5B4\uB0B4\uACE0
    \uAC04 \uC794\uC778\uD55C \uC800\uC8FC\uC758 \uC794\uC0C1\uB9CC\uC774 \uC11C\uB298\uD558\uAC8C
    \uAC10\uB3C8\uB2E4.)  "
