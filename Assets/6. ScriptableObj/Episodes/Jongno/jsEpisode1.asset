  m_Script: {fileID: 11500000, guid: d86ef726ec2bb1340be9fc0a470d9b84, type: 3}
  m_Name: jsEpisode1
  m_EditorClassIdentifier: 
  texts:
  - "`#(\uC11C\uC6B8 \uC2DC\uC7A5\uC73C\uB85C \uBD80\uC784\uB41C \uC9C0 \uC5BC\uB9C8\uB418\uC9C0
    \uC54A\uC740 \uC5B4\uB290 \uB0A0.) "
  - "`#(\uC885\uB85C\uAD6C\uB85C\uBD80\uD130 \uAC70\uB9AC \uC55E \uACF5\uC6D0\uC5D0\uC11C
    \uBCF4\uC790\uB294 \uC5F0\uB77D\uC774 \uC654\uB2E4.) "
  - "`#\u201C\uC5EC\uAE34\u2026 \uAC00?\u201D"
  - "`#(\uADF8\uC758 \uB208 \uC55E\uC5D0 \uD3BC\uCCD0\uC9C4 \uAC70\uB9AC\uB294 \uADF8\uB098\uB9C8
    \uBC88\uD654\uAC00\uB77C\uB294 \uBD84\uC704\uAE30\uB97C \uD480\uD480 \uD48D\uAE30\uB294
    \uC885\uB85C\uAD6C\uC758 \uAC70\uB9AC\uC600\uB2E4.)"
  - "`#(\uBB38\uB4DD \uADF8 \uAC70\uB9AC\uB97C \uC9C0\uB098\uAC00\uB294 \uAC83\uC774
    \uC775\uC219\uD574\uC838 \uC81C\uB300\uB85C \uB290\uB07C\uC9C0 \uBABB\uD55C \uC544\uB984\uB2E4\uC6C0\uC774
    \uBA4D\uD558\uB2C8 \uC788\uC73C\uB2C8 \uB208\uC5D0 \uB4E4\uC5B4\uC624\uAE30 \uC2DC\uC791\uD588\uB2E4.)"
  - "`#(\uC774\uB0B4 \uC5BC\uB9C8 \uC548 \uAC00 \uADFC\uCC98\uC5D0\uC11C \uC778\uAE30\uCC99\uC774
    \uB290\uAEF4\uC838\uC654\uB2E4.)"
  - "[menhera]\u201C\uC6B0\uB9AC \uC2DC\uC7A5\uB2D8 \uAC70\uAE30\uC11C \uBC14\uBCF4\uCC98\uB7FC
    \uBB50\uD574? \uC544 \uC6D0\uB798 \uBC14\uBCF4\uC600\uB098?\u201D"
  - "`#(... \uC65C \uBD88\uB800\uB294 \uC9C0 \uBC8C\uC368\uBD80\uD130 \uAC10\uC774
    \uC624\uB294 \uAC83 \uAC19\uC740 \uAE30\uBD84\uC774 \uB4E4\uC5C8\uB2E4.) "
  - "`#(\uBCF4\uD1B5\uC774\uB77C\uBA74 \uC628\uD654\uD55C \uBAA9\uC18C\uB9AC\uC640
    \uC2DC\uC120\uC744 \uAC00\uC9C4 \uC0AC\uB78C\uC774\uC5C8\uC744 \uC885\uB85C\uAD6C\uC758
    \uBAA9\uC18C\uB9AC\uAC00 \uC628\uD654\uD568\uC740 \uCEE4\uB155, \uB531\uB531\uD558\uACE0
    \uAC10\uC815\uC774\uB77C\uACE4 \uBB3B\uC5B4\uC788\uC9C0 \uC54A\uC558\uB2E4.) "
  - "#\"\uC751? \uC544, \uC654\uC5B4? \uADFC\uB370 \uC65C \uBCF4\uC790\uACE0 \uD55C
    \uAC70\uC57C?\u201D"
  - '[menhera]"....."'
  - "`#(\uB9D0\uD558\uAE30 \uC2EB\uC740 \uAC78\uAE4C, \uC544\uB2C8\uBA74 \uB9D0\uC744
    \uD558\uBA74 \uC548 \uB418\uB294 \uAC78\uAE4C. \uBB34\uC2EC\uD55C \uC5BC\uAD74\uC774
    \uC624\uD788\uB824 \uC5EC\uAE30\uB85C \uBD80\uB978 \uC774\uC720\uB97C \uC9D0\uC791\uD558\uAE30
    \uC5B4\uB835\uAC8C \uB9CC\uB4E4\uC5C8\uB2E4.)"
  - "`#\u201C\uBB54\uAC00 \uC548 \uC88B\uC740 \uC77C\uC774\uB77C\uB3C4 \uC788\uB294
    \uAC70\uC57C?\u201D "
  - "[tired]\u201C....\uC544\uB0D0, \uC544\uBB34\uAC83\uB3C4.\u201D"
  - "`#(\uC74C, \uBD84\uBA85\uD788 \uBB34\uC5B8\uAC00 \uC788\uB294 \uAC8C \uD655\uC2E4\uD558\uB2E4.) "
  selects:
  - {fileID: 11400000, guid: 5f46868046842464497dc01a43caeae9, type: 2}
