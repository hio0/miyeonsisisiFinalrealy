  m_Name: Ep2_S2M
  m_EditorClassIdentifier: 
  selectname: "\u201C\uC774\uAC8C \uBB34\uC2A8 \uCD94\uD0DC\uB0D0! \uC774\uB7F0 \uB054\uCC0D\uD55C
    \uC790\uD574 \uC18C\uB3D9\uC73C\uB85C \uB0B4 \uB9C8\uC74C\uC744 \uC6C0\uC9C1\uC774\uB824
    \uB4E4\uB2E4\uB2C8, \uB10C \uC815\uB9D0 \uCE58\uB8CC\uAC00 \uD544\uC694\uD55C
    \uC815\uC2E0\uBCD1\uC790\uAD70!\u201D "
  th: 1
  iscorrect: 0
  selectedlog:
  - "#(\uADF8\uB140\uB97C \uC704\uB85C\uD558\uAE30\uB294\uCEE4\uB155, \uBE44\uC815\uC0C1\uC801\uC778
    \uD589\uB3D9\uC5D0 \uC18C\uB984\uC774 \uB07C\uCE5C\uB2E4\uB294 \uB4EF \uADF8\uB140\uB97C
    \uAC70\uCE60\uAC8C \uBC00\uCCD0\uB0B4\uBA70 \uC3D8\uC544\uBD99\uC778\uB2E4.) "
  - "#(\uBC14\uB2E5\uC5D0 \uAC70\uCE60\uAC8C \uBC00\uB824 \uB118\uC5B4\uC9C4 \uC11C\uB300\uBB38\uAD6C\uC758
    \uBB34\uB98E\uC774 \uC4F8\uB824 \uBD89\uC740 \uD53C\uAC00 \uBC30\uC5B4 \uB098\uC628\uB2E4.) "
  - "#(\uB0B4 \uB0C9\uD639\uD55C \uD3ED\uC5B8\uC774 \uADF8\uB140\uAC00 \uB9E4\uB2EC\uB824
    \uC788\uB358 \uB9C8\uC9C0\uB9C9 \uC815\uC2E0\uC801 \uBCF4\uB8E8\uB97C \uC644\uC804\uD788
    \uC0B0\uC0B0\uC870\uAC01 \uB0B4\uBC84\uB838\uB2E4.) "
  - " \u201C\uC815\uC2E0\uBCD1\uC790\u2026\u2026 \uCD94\uD0DC\u2026\u2026 \uC544\uD558\uD558,
    \uADF8\uB798\uC694\u2026\u2026 \uB098 \uAC19\uC740 \uC544\uC2F8 \uBC31\uC218\uB144\uC774
    \uD558\uB294 \uC9D3\uC774 \uB2E4 \uADF8\uB807\uC9C0 \uBB50\u2026\u2026 \uC560\uCD08\uC5D0
    \uB098 \uAC19\uC740 \uAC74 \uC2DC\uC7A5\uB2D8\uAED8 \uC0AC\uB791\uBC1B\uC744
    \uC790\uACA9\uB3C4 \uC5C6\uC5C8\uB358 \uAC70\uC57C\u2026\u2026.\u201D "
  - "#(\uADF8\uB140\uB294 \uBC14\uB2E5\uC5D0 \uB5A8\uC5B4\uC9C4 \uB0AB\uC744 \uCC59\uAE30\uC9C0\uB3C4
    \uC54A\uC740 \uCC44, \uD53C\uAC00 \uD750\uB974\uB294 \uB2E4\uB9AC\uB97C \uC774\uB04C\uACE0
    \uC5B4\uB450\uC6B4 \uACE8\uBAA9\uAE38 \uC74C\uC9C0 \uC18D\uC73C\uB85C \uAE30\uAD34\uD558\uAC8C
    \uC6C3\uC73C\uBA70 \uB3C4\uB9DD\uCE58\uB4EF \uC0AC\uB77C\uC838 \uBC84\uB9B0\uB2E4.)"
