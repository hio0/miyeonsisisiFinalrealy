  m_Script: {fileID: 11500000, guid: 00e1018d78f20f54d8f56740326b35c6, type: 3}
  m_Name: Ep2_S2C
  m_EditorClassIdentifier: 
  selectname: " \u201C\uBC14\uBCF4 \uAC19\uC740 \uC9D3 \uD558\uC9C0 \uB9C8! \uB124\uAC00
    \uB2E4\uCE58\uBA74 \uC774 \uBAA9\uB3C4\uB9AC\uB3C4, \uC774 \uB545\uB3C4 \uB0B4\uAC90
    \uC544\uBB34 \uC758\uBBF8 \uC5C6\uC5B4! \uB09C \uC808\uB300 \uB108 \uC548 \uBC84\uB9AC\uB2C8\uAE4C
    \uC81C\uBC1C \uC815\uC2E0 \uCC28\uB824!\u201D"
  th: 1
  iscorrect: 1
  selectedlog:
  - "#(\uB9DD\uC124\uC784 \uC5C6\uC774 \uC55E\uC73C\uB85C \uB6F0\uC5B4\uB4E4\uC5B4
    \uADF8\uB140\uC758 \uC190\uBAA9\uC744 \uB09A\uC544\uCC44 \uB0AB\uC744 \uBC14\uB2E5\uC73C\uB85C
    \uCCD0\uB0B4\uACE0, \uACF5\uD3EC\uC5D0 \uC9C8\uB824 \uBC14\uB4E4\uBC14\uB4E4
    \uB5A0\uB294 \uADF8\uB140\uC758 \uB9C8\uB978 \uBAB8\uC744 \uBD80\uC11C\uC9C8
    \uB4EF \uAC15\uD558\uAC8C \uB04C\uC5B4\uC548\uC73C\uBA70)"
  - "#(\uB0AB\uC774 \uC2DC\uBA58\uD2B8 \uBC14\uB2E5\uC5D0 \uCA0D\uADF8\uB791 \uAD6C\uB974\uACE0,
    \uCDA9\uACA9\uC73C\uB85C \uADF8\uB140\uC758 \uBC00\uC9DA\uBAA8\uC790\uAC00 \uBC97\uACA8\uC838
    \uB0B4\uB9B0\uB2E4.) #(\uB0B4 \uD488\uC5D0 \uC548\uAE34 \uC11C\uB300\uBB38\uAD6C\uC758
    \uCCB4\uAD6C\uAC00 \uB0B4 \uAC70\uCE5C \uC228\uC18C\uB9AC\uC640 \uC628\uAE30\uB97C
    \uB290\uB07C\uBA70 \uC11C\uC11C\uD788 \uC548\uC815\uC744 \uB418\uCC3E\uB294\uB2E4.)"
  - "#(\uB0B4\uAC00 \uB450\uB978 \uCD08\uB85D\uC0C9 \uBAA9\uB3C4\uB9AC\uC5D0 \uADF8\uB140\uC758
    \uB728\uAC70\uC6B4 \uB208\uBB3C\uC774 \uC11C\uC11C\uD788 \uC5BC\uB8E9\uC9C0\uBA70
    \uBC30\uC5B4\uB4E0\uB2E4.) "
  - "\u201C\uC2DC\uC7A5\uB2D8\u2026\u2026 \uD750\uC73D, \uC73C\uC544\uC559\u2026\u2026!
    \uBB34\uC11C\uC6E0\uC5B4\uC694\u2026\u2026 \uC2DC\uC7A5\uB2D8\uB9C8\uC800 \uC5B8\uB2C8\uD55C\uD14C
    \uAC00\uBC84\uB9AC\uACE0 \uB098\uB9CC \uD63C\uC790 \uBC84\uB824\uC9C8\uAE4C \uBD10\u2026\u2026
    \uC9C4\uC9DC \uB108\uBB34 \uBB34\uC11C\uC6E0\uB2E8 \uB9D0\uC774\uC5D0\uC694\u2026\u2026!\u201D "
  - "#(\uADF8\uB140\uB294 \uB0B4 \uC637\uC790\uB77D\uC744 \uCC22\uC5B4\uC9C8 \uB4EF
    \uC6C0\uCF1C\uC7A1\uC73C\uBA70, \uC6A9\uC5ED\uB4E4\uC758 \uC2DC\uC120\uB3C4 \uC544\uB791\uACF3\uD558\uC9C0
    \uC54A\uACE0 \uD488\uC5D0 \uC548\uACA8 \uC11C\uB7FD\uAC8C \uC624\uC5F4\uD55C\uB2E4.
    \uADF8 \uAE30\uC138\uC5D0 \uB2F9\uD669\uD55C \uC6A9\uC5ED\uB4E4\uC740 \uD600\uB97C
    \uCC28\uBA70 \uC790\uB9AC\uB97C \uD53C\uD55C\uB2E4.) "
