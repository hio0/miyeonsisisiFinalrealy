  m_Script: {fileID: 11500000, guid: d86ef726ec2bb1340be9fc0a470d9b84, type: 3}
  m_Name: SdEpisode1
  m_EditorClassIdentifier: 
  texts:
  - "`#(\uB3D9\uB300\uBB38\uAD6C\uC758 \uC30D\uB465\uC774 \uC790\uB9E4\uC774\uC790,
    \uACFC\uAC70 \uC11C\uC6B8\uC758 \uC678\uACFD \uB18D\uCD0C \uC9C0\uC5ED\uC774\uC5C8\uB358
    \uD754\uC801\uC744 \uAC04\uC9C1\uD55C \uC11C\uB300\uBB38\uAD6C\uB97C \uB9CC\uB09C
    \uC9C0 \uC5BC\uB9C8 \uB418\uC9C0 \uC54A\uC740 \uC5B4\uB290 \uB0A0 \uC624\uD6C4.)"
  - "`#(\uADF8\uB140\uB294 \uD654\uB824\uD558\uACE0 \uAE30 \uC13C \uC30D\uB465\uC774
    \uC5B8\uB2C8\uC640 \uB2EC\uB9AC, \uD5DD\uD074\uC5B4\uC9C4 \uB179\uBC1C \uC7A5\uBC1C
    \uC0DD\uBA38\uB9AC\uC5D0 \uCEE4\uB2E4\uB780 \uC548\uACBD\uC744 \uC4F0\uACE0 \uBC00\uC9DA\uBAA8\uC790\uB97C
    \uD479 \uB20C\uB7EC\uC4F4 \uC218\uC218\uD55C \uCC28\uB9BC\uC774\uC5C8\uB2E4.)"
  - "`#(\uD3C9\uC18C \uC9C0\uB3C5\uD55C \uC678\uB85C\uC6C0\uACFC \uBD84\uB9AC\uBD88\uC548\uC744
    \uC553\uC73C\uBA70 \uBC29\uC5D0\uB9CC \uD2C0\uC5B4\uBC15\uD600 \uC9C0\uB0B4\uB358
    \uADF8\uB140\uAC00, \uD070 \uC6A9\uAE30\uB97C \uB0B4\uC5B4 \uB098\uB97C \uC790\uC2E0\uC758
    \uB0A1\uC740 \uC790\uCDE8\uBC29\uC73C\uB85C \uCD08\uB300\uD588\uB2E4.)"
  - "`#(\uD0C1\uC790 \uC704\uC5D0\uB294 \uADF8\uB140\uAC00 \uC11C\uD230 \uC19C\uC528\uB85C
    \uBA70\uCE60 \uBC24\uC744 \uC0C8\uC6CC \uAC00\uBA70 \uB72C \uCD08\uB85D\uC0C9
    \uD138\uBAA9\uB3C4\uB9AC\uC640, \uC815\uC131\uC2A4\uB808 \uCC28\uB824\uB0B8 \uB530\uB73B\uD55C
    \uAC00\uC815\uC2DD \uBC31\uBC18\uC774 \uB193\uC5EC \uC788\uC5C8\uB2E4.)"
  - "[sad]\u201C\uC2DC, \uC2DC\uC7A5\uB2D8\u2026\u2026 \uC800 \uAC19\uC740 \uBE44\uC790\uBC1C\uC801
    \uC544\uC2F8\uC5D0, \uC544\uC9C1 \uCDE8\uC5C5\uB3C4 \uBABB \uD55C \uD55C\uC2EC\uD55C
    \uC560\uC758 \uBC29\uC5D0 \uC640\uC8FC\uC154\uC11C \uAC10\uC0AC\uD574\uC694\u2026\u2026
    \uB298 \uD63C\uC790\uB77C \uB108\uBB34 \uC678\uB85C\uC6E0\uB294\uB370\u2026\u2026\u201D "
  - "[sad]\u201C\uC5EC\uAE30 \uC774 \uBAA9\uB3C4\uB9AC, \uC2DC\uC7A5\uB2D8 \uC0DD\uAC01\uD558\uBA74\uC11C
    \uBC24\uB9C8\uB2E4 \uCF54 \uC9DC\uC11C \uB9CC\uB4E0 \uAC70\uC608\uC694\u2026\u2026
    \uD55C\uBC88 \uD574\uBD10 \uC8FC\uC2DC\uBA74 \uC548 \uB420\uAE4C\uC694\u2026\u2026?\u201D"
  - "`#(\uC548\uACBD \uB108\uBA38\uB85C \uC21C\uC218\uD558\uACE0 \uC21C\uC9C4\uD55C
    \uB208\uB9DD\uC6B8\uC744 \uBC18\uC9DD\uC774\uBA70 \uB0B4 \uBC18\uC751\uC744 \uCD08\uC870\uD558\uAC8C
    \uAE30\uB2E4\uB9AC\uB294 \uC11C\uB300\uBB38\uAD6C.)"
  - "`#(\uD558\uC9C0\uB9CC \uB0B4\uAC00 \uBAA9\uB3C4\uB9AC\uB97C \uB9CC\uC9C0\uB824\uB358
    \uCC30\uB098, \uAC11\uC790\uAE30 \uADF8\uB140\uC758 \uD734\uB300\uD3F0\uC5D0\uC11C
    \uC11C\uB300\uBB38\uAD6C \uC9C0\uC5ED\uC758 \uAE09\uACA9\uD55C \uB3C4\uC2DC\uD654
    \uBC0F \uC7AC\uAC1C\uBC1C \uACF5\uCCAD\uD68C \uB274\uC2A4\uAC00 \uD758\uB7EC\uB098\uC654\uB2E4.)"
  - "`#(\uB099\uD6C4\uB41C \uACE0\uD5A5\uC774 \uC2F9 \uBC00\uB824\uB098\uAC00\uACE0
    \uC5B8\uB2C8\uCC98\uB7FC \uD654\uB824\uD558\uAC8C \uBCC0\uD574\uC57C \uD55C\uB2E4\uB294
    \uC555\uBC15\uAC10, \uADF8\uB9AC\uACE0 \uC644\uBCBD\uD55C \uB3C4\uC2DC\uAC00
    \uB418\uBA74 \uC2DC\uC7A5\uB2D8\uC774 \uC790\uC2E0\uC744 \uB5A0\uB0A0\uC9C0\uB3C4
    \uBAA8\uB978\uB2E4\uB294 \uADF9\uB2E8\uC801\uC778 \uBD84\uB9AC\uBD88\uC548\uC774
    \uADF8\uB140\uC758 \uC5EC\uB9B0 \uC815\uC2E0\uC744 \uC21C\uC2DD\uAC04\uC5D0 \uC9D1\uC5B4\uC0BC\uCF30\uB2E4.)"
  - "`#(\uB208\uBE5B\uC774 \uC644\uC804\uD788 \uD480\uB9B0 \uC11C\uB300\uBB38\uAD6C\uB294
    \uAD6C\uC11D\uC5D0 \uC7A5\uC2DD\uC6A9\uC73C\uB85C \uB450\uC5C8\uB358 \uCEE4\uB2E4\uB780
    \uB18D\uC0AC\uC6A9 \uB0AB\uC744 \uC11C\uC2AC \uD37C\uB807\uAC8C \uCE58\uCF1C\uB4E4\uB354\uB2C8,
    \uC790\uC2E0\uC758 \uB9C8\uB978 \uC190\uBAA9\uC5D0 \uB0A0\uC744 \uB4E4\uC774\uB300\uBA70
    \uB35C\uB35C \uB5A8\uAE30 \uC2DC\uC791\uD588\uB2E4.)"
  - "[menhera]\u201C\uC544, \uC544\uB0D0\u2026\u2026 \uAC1C\uBC1C \uAC19\uC740 \uAC70
    \uB418\uBA74 \uB09C \uC5B8\uB2C8\uCC98\uB7FC \uBCC0\uD574\uBC84\uB9B4 \uAC70\uACE0,
    \uADF8\uB7FC \uC2DC\uC7A5\uB2D8\uC740 \uB0A0 \uC548 \uBD10\uC904 \uAC70\uC796\uC544\u2026\u2026
    \uB098\uB9CC \uC5EC\uAE30 \uBA48\uCDB0\uC788\uC73C\uBA74,\u201D "
  - "[menhera]\u201C\uB0A0 \uACC4\uC18D \uB3D9\uC815\uD574\uC11C\uB77C\uB3C4 \uACC1\uC5D0
    \uC788\uC5B4 \uC904 \uAC70\uC8E0? \uB300\uB2F5\uD574 \uC918\uC694\u2026\u2026
    \uC548 \uADF8\uB7EC\uBA74 \uB098, \uC9C0\uAE08 \uC5EC\uAE30\uC11C \uC774 \uB0AB\uC73C\uB85C\u2026\u2026!\u201D"
  - "`#(\uC21C\uC2DD\uAC04\uC5D0 \uBA58\uD5E4\uB77C \uC99D\uC138\uAC00 \uBC1C\uD604\uB418\uC5B4
    \uB0AB\uC73C\uB85C \uC790\uD574\uB97C \uD558\uB824\uB294 \uC21C\uC9C4\uD558\uACE0
    \uB098\uC57D\uD55C \uADF8\uB140\uB97C \uB9C8\uC8FC\uD55C \uC0C1\uD669.)"
  - "*#(\uBD88\uC548\uC5D0 \uBBF8\uCCD0\uBC84\uB9B0 \uC11C\uB300\uBB38\uAD6C\uB97C
    \uC9C4\uC815\uC2DC\uD0A4\uAE30 \uC704\uD574 \uB2E8 \uD55C \uBC88\uC758 \uACB0\uC815\uC801\uC778
    \uC120\uD0DD\uC744 \uB0B4\uB824\uC57C \uD55C\uB2E4.)"
  selects:
  - {fileID: 11400000, guid: 6a0c191b8042d91488fe23541f4fe771, type: 2}
  - {fileID: 11400000, guid: 4feb42b2e27340541a395cf894b363ab, type: 2}
