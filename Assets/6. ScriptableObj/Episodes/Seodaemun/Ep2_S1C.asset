  selectname: "(\uB9DD\uC124\uC784 \uC5C6\uC774 \uC55E\uC73C\uB85C \uAC78\uC5B4\uAC00
    \uADF8\uB140\uC758 \uC190\uC5D0\uC11C \uB0A0\uCE74\uB85C\uC6B4 \uB0AB\uC744 \uBD80\uB4DC\uB7FD\uAC8C
    \uBE7C\uC557\uC544 \uBA40\uB9AC \uB358\uC838\uBC84\uB9AC\uACE0,)"
  th: 0
  iscorrect: 1
  selectedlog:
  - "#(\uB5A8\uACE0 \uC788\uB294 \uADF8\uB140\uC758 \uAC00\uB140\uB9B0 \uBAB8\uC744
    \uD488\uC5D0 \uAF2D \uC548\uC544\uC8FC\uBA70)"
  - "#\u201C\uAC1C\uBC1C\uC774 \uB418\uB4E0 \uC138\uC0C1\uC774 \uBCC0\uD558\uB4E0,
    \uB0B4\uAC90 \uC9C0\uAE08 \uC774 \uC218\uC218\uD55C \uB124 \uBAA8\uC2B5\uC774
    \uAC00\uC7A5 \uC18C\uC911\uD574. \uC808\uB300 \uD63C\uC790 \uB450\uC9C0 \uC54A\uC744
    \uD14C\uB2C8\uAE4C \uBD88\uC548\uD574\uD558\uC9C0 \uB9C8.\u201D"
  - "#(\uB0AB\uC774 \uBC14\uB2E5\uC73C\uB85C \uCA0D\uADF8\uB791 \uB5A8\uC5B4\uC9C0\uACE0,
    \uBC00\uC9DA\uBAA8\uC790\uAC00 \uBC97\uACA8\uC9C0\uBA70 \uADF8\uB140\uC758 \uD5DD\uD074\uC5B4\uC9C4
    \uB179\uBC1C \uC0DD\uBA38\uB9AC\uAC00 \uB0B4 \uC5B4\uAE68 \uC704\uB85C \uC3DF\uC544
    \uB0B4\uB824\uC9C4\uB2E4.)"
  - "#(\uD488\uC5D0 \uC548\uAE34 \uC11C\uB300\uBB38\uAD6C\uC758 \uB9C8\uB978 \uBAB8\uC774
    \uB0B4 \uC628\uAE30\uB97C \uB290\uB07C\uC790\uB9C8\uC790 \uAC70\uC9D3\uB9D0\uCC98\uB7FC
    \uB5A8\uB9BC\uC744 \uBA48\uCD98\uB2E4.)"
  - "#(\uC2EC\uC7A5\uC774 \uD130\uC9C8 \uB4EF\uC774 \uB6F0\uBA70 \uB0B4 \uC637\uC790\uB77D\uC744
    \uB208\uBB3C\uB85C \uC801\uC2DC\uB294 \uADF8\uB140.)"
  - " \u201C\uC2DC\uC7A5\uB2D8\u2026\u2026 \uC9C4\uC9DC\uB85C \uC800 \uC548 \uBC84\uB9AC\uC2E4
    \uAC70\uC608\uC694? \uB3C4\uC2DC\uAC00 \uB418\uC5B4\uB3C4 \uACC4\uC18D \uC81C
    \uACC1\uC5D0\u2026\u2026 \uC57D\uC18D\uD558\uC2E0 \uAC70\uC608\uC694\u2026\u2026
    \uD788\uC775, \uC73C\uC559\u2026\u2026!\u201D"
  - "#(\uC9C0\uB3C5\uD55C \uC678\uB85C\uC6C0 \uC18D\uC5D0 \uAC07\uD600 \uC788\uB358
    \uADF8\uB140\uAC00 \uB9C8\uCE68\uB0B4 \uAD6C\uC6D0\uC744 \uBC1B\uC740 \uB4EF,
    \uB3C5\uAE30\uB97C \uBC84\uB9AC\uACE0 \uB0B4 \uD488\uC5D0 \uC5BC\uAD74\uC744
    \uBB3B\uC740 \uCC44 \uC5B4\uB9B0\uC544\uC774\uCC98\uB7FC \uC11C\uB7FD\uAC8C \uC624\uC5F4\uD558\uAE30
    \uC2DC\uC791\uD55C\uB2E4.)"
