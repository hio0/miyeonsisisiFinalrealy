  m_Script: {fileID: 11500000, guid: d86ef726ec2bb1340be9fc0a470d9b84, type: 3}
  m_Name: SdEpisode2
  m_EditorClassIdentifier: 
  texts:
  - "`#(\uB099\uC5FD\uC774 \uAC70\uB9AC\uB97C \uB4B9\uAD6C\uB294 \uC300\uC300\uD55C
    \uB2A6\uAC00\uC744 \uC800\uB141, \uD64D\uC81C\uB3D9\uC758 \uD55C \uD55C\uC801\uD55C
    \uC8FC\uD0DD\uAC00 \uACE8\uBAA9\uAE38.) "
  - "`#(\uAC00\uB85C\uB4F1 \uBD88\uBE5B \uC544\uB798\uC5D0\uC11C \uC11C\uB300\uBB38\uAD6C\uAC00
    \uC678\uD22C \uC8FC\uBA38\uB2C8\uC5D0 \uB450 \uC190\uC744 \uCC14\uB7EC \uB123\uC740
    \uCC44 \uC5F0\uC2E0 \uBC1C\uC744 \uB3D9\uB3D9 \uAD6C\uB974\uACE0 \uC788\uC5C8\uB2E4.
    \uD5DD\uD074\uC5B4\uC9C4 \uB179\uBC1C \uC0DD\uBA38\uB9AC \uC704\uB85C \uD479
    \uB20C\uB7EC\uC4F4 \uBC00\uC9DA\uBAA8\uC790\uAC00 \uBC24\uBC14\uB78C\uC5D0 \uC791\uAC8C
    \uD754\uB4E4\uB838\uB2E4.) "
  - "`#(\uB098\uB97C \uBC1C\uACAC\uD558\uC790\uB9C8\uC790 \uC548\uACBD \uB108\uBA38\uC758
    \uB208\uC744 \uBC18\uC9DD\uC774\uBA70 \uB2EC\uB824\uC628 \uADF8\uB140\uB294,
    \uD488 \uC548\uC5D0\uC11C \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uBB34\uC5B8\uAC00\uB97C
    \uAEBC\uB0B4 \uB0B4\uBC00\uC5C8\uB2E4. \uD55C \uC62C \uD55C \uC62C \uC815\uC131\uC2A4\uB7FD\uAC8C
    \uB72C \uCD08\uB85D\uC0C9 \uD138\uBAA9\uB3C4\uB9AC\uC600\uB2E4."
  - "`#(\uC790\uC138\uD788 \uBCF4\uB2C8 \uADF8\uB140\uC758 \uC190\uAC00\uB77D \uB05D\uB9C8\uB2E4
    \uBA70\uCE60 \uBC24\uC744 \uC0C8\uC6CC \uBC14\uB290\uC9C8\uC744 \uD55C \uB4EF
    \uBC34\uB4DC\uAC00 \uCE6D\uCE6D \uAC10\uACA8 \uC788\uC5C8\uB2E4.) "
  - "[happy]\u201C\uC2DC\uC7A5\uB2D8\u2026\u2026! \uB9CE\uC774 \uAE30\uB2E4\uB9AC\uC168\uC8E0?
    \uB0A0\uC774 \uAC11\uC790\uAE30 \uB108\uBB34 \uCD94\uC6CC\uC838\uC11C\u2026\u2026
    \uC624\uB294 \uAE38\uC5D0 \uAC10\uAE30\uB77C\uB3C4 \uAC78\uB9AC\uC2E4\uAE4C \uBD10
    \uAC71\uC815\uD588\uC5B4\uC694.\u201D"
  - "`#\u201D\uC774\uAC70, \uC2DC\uC7A5\uB2D8 \uC0DD\uAC01\uD558\uBA74\uC11C \uBC24\uB9C8\uB2E4
    \uD55C \uCF54\uC529 \uB72C \uAC74\uB370\u2026\u2026 \uC81C \uC11C\uD230 \uC19C\uC528\uB77C
    \uB9C8\uC74C\uC5D0 \uB4DC\uC2E4\uC9C0 \uBAA8\uB974\uACA0\uC5B4\uC694\u2026\u2026.\u201D"
  - "*#(\uAE30\uB300\uC640 \uBD88\uC548\uC774 \uB4A4\uC11E\uC778 \uB208\uC73C\uB85C
    \uB0B4 \uB208\uCE58\uB97C \uC0B4\uD53C\uB294 \uC11C\uB300\uBB38\uAD6C. \uADF8\uB140\uC5D0\uAC8C
    \uCCAB \uBC88\uC9F8 \uB300\uB2F5\uC744 \uAC74\uB124\uC57C \uD55C\uB2E4.)"
  - "`#(\uADF8\uB807\uAC8C \uB300\uD654\uB97C \uB098\uB204\uB358 \uC911, \uC778\uADFC
    \uC7AC\uAC1C\uBC1C \uAD6C\uC5ED\uC744 \uB458\uB7EC\uBCF4\uB358 \uCCA0\uAC70 \uC6A9\uC5ED\uC5C5\uCCB4
    \uC9C1\uC6D0\uB4E4\uC774 \uBD89\uC740 \uAE43\uBC1C\uACFC \uB3C4\uAD6C\uB97C \uB4E0
    \uCC44 \uACE8\uBAA9\uAE38 \uC548\uCABD\uC73C\uB85C \uB4E4\uC774\uB2E5\uCCE4\uB2E4.) "
  - "`#(\uADF8\uB4E4\uC740 \uC6B0\uB9AC\uB97C \uD758\uB054\uAC70\uB9AC\uBA70 \"\uC5EC\uAE30\uB3C4
    \uC870\uB9CC\uAC04 \uC2F9 \uBC00\uC5B4\uBC84\uB9B4 \uD14C\uB2C8\uAE4C \uC5BC\uB978
    \uC9D0 \uC2F8\uC11C \uB098\uAC00\uB77C\"\uACE0 \uAC70\uCE60\uAC8C \uC73D\uBC15\uC9C8\uB800\uB2E4.)"
  - "`#(\uAC15\uC555\uC801\uC778 \uBAA9\uC18C\uB9AC\uC640 \uC704\uC555\uC801\uC778
    \uD0DC\uB3C4\uC5D0 \uB178\uCD9C\uB418\uC790, \uD3C9\uC18C \uC9C0\uB3C5\uD55C
    \uC678\uB85C\uC6C0\uACFC \uBD84\uB9AC\uBD88\uC548\uC744 \uC553\uB358 \uC11C\uB300\uBB38\uAD6C\uC758
    \uC815\uC2E0\uC774 \uC21C\uC2DD\uAC04\uC5D0 \uBB34\uB108\uC9C0\uAE30 \uC2DC\uC791\uD588\uB2E4.) "
  - "`#(\uC774 \uB3D9\uB124\uAC00 \uBC00\uB824\uB098\uBA74 \uC218\uC218\uD55C \uC790\uC2E0\uC740
    \uD754\uC801\uB3C4 \uC5C6\uC774 \uC78A\uD790 \uAC83\uC774\uACE0, \uC2DC\uC7A5\uB2D8\uB9C8\uC800
    \uD654\uB824\uD55C \uC5B8\uB2C8\uC5D0\uAC8C \uAC00\uBC84\uB9B4\uC9C0 \uBAA8\uB978\uB2E4\uB294
    \uADF9\uB2E8\uC801\uC778 \uB9DD\uC0C1\uC774 \uADF8\uB140\uB97C \uC9D1\uC5B4\uC0BC\uCF30\uB2E4.)"
  - "`#(\uB208\uB3D9\uC790\uC758 \uCD08\uC810\uC774 \uD750\uB824\uC9C4 \uADF8\uB140\uB294
    \uC678\uD22C \uC8FC\uBA38\uB2C8\uC5D0\uC11C \uD143\uBC2D\uC744 \uAC00\uAFC0 \uB54C
    \uC4F0\uB358 \uC791\uC740 \uC6D0\uC608\uC6A9 \uB0AB\uC744 \uAEBC\uB0B4 \uB4E4\uB354\uB2C8,
    \uC6A9\uC5ED\uB4E4\uC744 \uD5A5\uD558\uB294 \uAC8C \uC544\uB2C8\uB77C \uC790\uC2E0\uC758
    \uC190\uBAA9\uC5D0 \uB0A0\uCE74\uB85C\uC6B4 \uB0A0\uC744 \uBC14\uC9DD \uB4E4\uC774\uB314\uB2E4.)"
  - "[menhera]\u201C\uC548 \uB3FC\u2026\u2026 \uC5EC\uAE30\uB97C \uBC00\uC5B4\uBC84\uB9AC\uBA74
    \uB09C \uC774\uC81C \uAC08 \uACF3\uC774 \uC5C6\uB2E8 \uB9D0\uC774\uC57C\u2026\u2026
    \uC2DC\uC7A5\uB2D8, \uB0B4\uAC00 \uC5EC\uAE30\uC11C \uD53C\uB97C \uD758\uB824\uC57C
    \uC774 \uB545\uC744 \uC548 \uC5C6\uC568 \uAC70\uC608\uC694?\""
  - "[menhera]\"\uB0B4\uAC00 \uB2E4\uCE58\uBA74\u2026\u2026 \uADF8\uB7FC \uB098 \uAC00\uC5FD\uAC8C
    \uC5EC\uACA8\uC11C\uB77C\uB3C4 \uB0B4 \uACC1\uC5D0 \uD3C9\uC0DD \uB0A8\uC544\uC904
    \uAC70\uC8E0\u2026\u2026? \uC751\u2026\u2026?\u201D "
  - "`#(\uC21C\uC9C4\uD588\uB358 \uBAA8\uC2B5\uC740 \uC0AC\uB77C\uC9C0\uACE0, \uC624\uC9C1
    \uBC84\uB824\uC9C0\uC9C0 \uC54A\uACA0\uB2E4\uB294 \uC77C\uB150 \uD558\uB098\uB85C
    \uC790\uD574\uB97C \uC2DC\uB3C4\uD558\uB824\uB294 \uC704\uD0DC\uB85C\uC6B4 \uC21C\uAC04.)"
  - "*#(\uADF8\uB140\uC758 \uD3ED\uC8FC\uB97C \uB9C9\uACE0 \uC0C1\uD669\uC744 \uC218\uC2B5\uD558\uAE30
    \uC704\uD574 \uB450 \uBC88\uC9F8 \uCD5C\uC885 \uC120\uD0DD\uC744 \uB0B4\uB824\uC57C
    \uD55C\uB2E4.) "
  selects:
  - {fileID: 11400000, guid: 46971e89481d7e54bad2f6d616ca8c1b, type: 2}
  - {fileID: 11400000, guid: 9a7144f922a1c024ba187fdc833205be, type: 2}
  - {fileID: 11400000, guid: 0f4a298394d52d44fa743035ba7fd262, type: 2}
  - {fileID: 11400000, guid: c05c48383e78afb4da4960a50bc69ec6, type: 2}
