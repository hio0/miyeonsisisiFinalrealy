  m_Script: {fileID: 11500000, guid: 00e1018d78f20f54d8f56740326b35c6, type: 3}
  m_Name: Ep2_Y2M
  m_EditorClassIdentifier: 
  selectname: "\u201C\uADF8\uAC74 \uC57D\uC18D\uD560 \uC218 \uC5C6\uC5B4. \uB09C
    \uC11C\uC6B8 \u2018\uC804\uCCB4\u2019\uC758 \uC2DC\uC7A5\uC774\uB2C8\uAE4C.\u201D
    ##(\uB2E8\uD638\uD558\uAC8C \uC120\uC744 \uADF8\uC73C\uBA70 \uAC70\uC808\uD55C\uB2E4.)"
  th: 1
  iscorrect: 0
  selectedlog:
  - "#(\uC2DC\uC7A5\uC758 \uBCF8\uBD84\uC744 \uB2E4\uD558\uAE30 \uC704\uD574 \uC794\uC778\uD558\uC9C0\uB9CC
    \uB0C9\uC815\uD55C \uD604\uC2E4\uC744 \uC77C\uAE68\uC6CC\uC8FC\uC5C8\uB2E4. \uB0B4
    \uB300\uB2F5\uC774 \uB5A8\uC5B4\uC9C0\uC790\uB9C8\uC790 \uC6A9\uC0B0\uAD6C\uC758
    \uC138\uC0C1\uC774 \uBB34\uB108\uC838 \uB0B4\uB9AC\uB294 \uB4EF\uD588\uB2E4.)  "
  - "\u201C\u2026\u2026\uACB0\uAD6D, \uADF8\uAC70\uB124.\u201D "
  - "#(\uADF8\uB140\uB294 \uC7A1\uACE0 \uC788\uB358 \uB0B4 \uC637\uC790\uB77D\uC744
    \uC2A4\uB974\uB975 \uB193\uC558\uB2E4. \uD798\uC774 \uBE60\uC9C4 \uAC8C \uC544\uB2C8\uB77C,
    \uBAA8\uB4E0 \uAE30\uB300\uC640 \uBBF8\uB828\uC744 \uBC84\uB9B0 \uB4EF\uD55C
    \uC6C0\uC9C1\uC784\uC774\uC5C8\uB2E4.)"
  - "#(\uC778\uD130\uD3F0\uC744 \uB4E0 \uB0B4 \uC190\uBAA9\uC744 \uC6A9\uC0B0\uAD6C\uAC00
    \uBB34\uC11C\uC6B4 \uC545\uB825\uC73C\uB85C \uB09A\uC544\uCC44 \uBC14\uB2E5\uC73C\uB85C
    \uB0B4\uD33D\uAC1C\uCCE4\uB2E4. \uCF70\uC7A5\uCC3D \uD558\uB294 \uC18C\uB9AC\uC640
    \uD568\uAED8 \uC778\uD130\uD3F0\uC774 \uBC15\uC0B4 \uB0AC\uB2E4. \uC548\uADF8\uB798\uB3C4
    \uC8FD\uC5B4\uC788\uB358 \uADF8\uB140\uC758 \uC2DC\uC120\uC774, \uC774\uC81C\uB294
    \uC644\uC804\uD788 \uCD08\uC810\uC744 \uC783\uACE0 \uAD11\uAE30\uC5D0 \uBB3C\uB4E4\uC5B4
    \uC788\uC5C8\uB2E4.)"
  - "#(\uADF8\uB140\uB294 \uD480\uC5B4\uC9C4 \uAD70\uBCF5 \uC790\uCF13\uC744 \uB300\uCDA9
    \uCD94\uC2A4\uB974\uBA70 \uCC9C\uCC9C\uD788 \uC790\uB9AC\uC5D0\uC11C \uC77C\uC5B4\uB0AC\uB2E4.
    \uB208\uBB3C\uC740 \uBA48\uCDC4\uC9C0\uB9CC, \uADF8 \uB208\uBE5B\uC740 \uC601\uD558\uC758
    \uCE7C\uBC14\uB78C\uBCF4\uB2E4 \uCC28\uAC00\uC6E0\uB2E4.) "
  - "\u201C\uC54C\uACA0\uC5B4, \uC2DC\uC7A5\u2018\uB2D8\u2019. \uACF5\uBB34\uC5D0
    \uBC29\uD574\uB418\uAC8C \uD574\uC11C \uC8C4\uC1A1\uD558\uAD70\uC694. \uC55E\uC73C\uB85C\uB294\u2026\u2026
    \uD63C\uC790\uC11C \uD574\uACB0\uD558\uC8E0. \uC5B4\uB5A4 \uBC29\uC2DD\uC744
    \uC368\uC11C\uB77C\uB3C4.\u201D"
  - "#(\uACBD\uC9C1\uB41C \uC790\uC138\uB85C \uAC70\uC218\uACBD\uB840\uB97C \uC62C\uB9B0
    \uADF8\uB140\uB294 \uB4A4\uB3C4 \uB3CC\uC544\uBCF4\uC9C0 \uC54A\uACE0 \uC5B4\uB460
    \uC18D\uC73C\uB85C \uAC78\uC5B4 \uB098\uAC14\uB2E4. \uB4F1 \uB4A4\uB85C \uB0A8\uACA8\uC9C4
    \uC11C\uB298\uD55C \uACBD\uACE0\uAC00 \uC2EC\uC7A5\uC744 \uBB34\uAC81\uAC8C \uC9D3\uB20C\uB800\uB2E4.) "
