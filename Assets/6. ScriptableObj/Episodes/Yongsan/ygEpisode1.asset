  m_Name: ygEpisode1
  m_EditorClassIdentifier: 
  texts:
  - "'#(\uC885\uB85C\uAD6C\uC758 \uBB38\uC81C\uB97C \uD574\uACB0\uD55C \uB4A4 \uBA70\uCE60
    \uB4A4 \uC6A9\uC0B0\uAD6C\uC758 \uC0C1\uD0DC\uAC00 \uC774\uC0C1\uD558\uB2E4\uB294
    \uBB38\uC790\uB97C \uC885\uB85C\uAD6C\uC5D0\uAC8C \uBC1B\uC558\uB2E4.) "
  - "`#(\uACE7\uC7A5 \uAC71\uC815\uB418\uB294 \uC2EC\uC815\uC744 \uC228\uAE34 \uCC44
    \uC6A9\uC0B0\uAD6C\uB85C \uD5A5\uD55C\uB2E4.)"
  - "`# \u201C\uC5EC\uAE30\uB294..\u201D"
  - "`#(\uADF8\uC758 \uC2DC\uC120\uC774 \uD5A5\uD55C \uACF3\uC740 \uC6A9\uC0B0\uAD6C\uC758
    \uAC74\uBB3C\uB4E4\uC774\uB2E4.)"
  - "`#(\uBD84\uBA85\uD788 \uC0AC\uD758\uC804\uC5D0 \uC654\uC744 \uB54C\uB9CC \uD574\uB3C4
    \uC788\uB358 \uAC74\uBB3C\uB4E4\uC740 \uC5B4\uB514\uB85C \uAC14\uB294 \uC9C0
    \uD754\uC801\uB3C4 \uC5C6\uC774 \uC0AC\uB77C\uC9C0\uACE0 \uADF8 \uC704\uB85C
    \uB610 \uB2E4\uB978 \uAC74\uBB3C\uB4E4\uC774 \uC62C\uB77C\uC654\uB2E4.) "
  - "`#(\uADF8\uB7EC\uD55C \uC0AC\uC2E4\uB4E4\uC744 \uB4A4\uB85C \uD55C \uCC44 \uC6A9\uC0B0\uAD6C\uB97C
    \uCC3E\uAE30 \uC704\uD574 \uB2EC\uB824\uBCF8\uB2E4.)"
  - "`#(\uC815\uC2E0\uC5C6\uC774 \uB2EC\uB9AC\uB294 \uBC1C\uC5D0 \uB9DD\uC124\uC784
    \uAC19\uC740 \uAC74 \uC5C6\uC5C8\uB2E4..) "
  - "`#(\uB418\uB824 \uD655\uC2E0\uC774 \uAC00\uB4DD\uD588\uB2E4.) "
  - "`#(\uADF8\uB9AC\uACE0 \uB9C8\uCE68\uB0B4 \uAE38\uC5D0\uC11C \uBCC0\uD574\uAC00\uB294
    \uB3C4\uB85C\uC640 \uAC74\uBB3C\uB4E4\uC744 \uC2DC\uAC04\uC774 \uBA48\uCD98 \uB4EF
    \uAC00\uB9CC\uD788 \uBC14\uB77C\uBCF4\uACE0 \uC788\uB294 \uC6A9\uC0B0\uAD6C\uC758
    \uB4A4\uD0DC\uB97C \uCC3E\uC558\uB2E4.) "
  - "#\u201C\uBB58 \uBCF4\uACE0 \uC788\uB294 \uAC70\uC57C?\u201D "
  - "#(\uADF8\uB7EC\uD55C \uC9C8\uBB38\uC744 \uB358\uC84C\uC74C\uC5D0\uB3C4 \uC6A9\uC0B0\uAD6C\uC5D0\uAC8C\uC11C
    \uB2F5\uC740 \uB3CC\uC544\uC624\uC9C0 \uC54A\uB294\uB2E4.)"
  - "#(\uAD1C\uD55C \uAC71\uC815\uC774 \uB4E4\uC5B4 \uC6A9\uC0B0\uAD6C\uC758 \uC5B4\uAE68\uB97C
    \uD68D\uD558\uACE0 \uC7A1\uB294\uB2E4.) "
  - "[menhera]%\u201C.....\u201D"
  - "#(\uADF8\uB140\uC758 \uC785\uC5D0\uB294 \uC785\uC220\uC774 \uB2EB\uD78C \uC0C1\uD0DC\uAC00
    \uC544\uB2CC \uC790\uC2E0\uC758 \uC190\uD1B1\uC744 \uB72F\uACE0 \uC788\uB294
    \uC0C1\uD0DC\uC600\uB2E4.) "
  - "#(\uB72F\uACE0 \uB2E4\uC2DC \uB72F\uAE30\uB97C \uBC18\uBCF5\uD55C \uD0D3\uC778\uC9C0
    \uC190\uD1B1\uC5D0\uC11C\uB294 \uBD89\uC740\uC0C9\uC758 \uD53C\uAC00 \uD758\uB7EC\uB098\uC624\uACE0
    \uC788\uC5C8\uB2E4.) "
  - "#(\uADF8\uB9AC\uACE0 \uB9CC\uC9C4 \uC5B4\uAE68\uC5D0\uC11C\uB294 \uB5A8\uB9BC\uC774
    \uC804\uD574\uC838 \uC654\uB2E4.)"
  - "#(\uADF8\uC81C\uC11C\uC57C \uC6A9\uC0B0\uAD6C\uB294 \uB098\uB97C \uBC1C\uACAC\uD55C
    \uB4EF \uB098\uC758 \uAC00\uC2B4 \uC544\uB798\uB85C \uB2EC\uB824\uC640 \uC548\uACBC\uB2E4.) "
  - "[sad]%\u201C..\uC65C.. \uC774\uC81C \uC654\uC5B4\u2026. \uC751?\u201D "
  - "#(\uC6A9\uC0B0\uAD6C\uC758 \uBAA9\uC18C\uB9AC\uB294 \uAE08\uBC29\uC774\uB77C\uB3C4
    \uAE68\uC9C8 \uC720\uB9AC\uCC98\uB7FC \uBD88\uC548\uD588\uB2E4.) "
  - "*#(\uB208\uB3D9\uC790\uB610\uD55C \uADF8\uC5D0 \uB9DE\uAC8C \uC0AC\uC2DC\uC0AC\uCCA0
    \uB5A8\uB9AC\uACE0 \uC788\uC5C8\uB2E4.) "
