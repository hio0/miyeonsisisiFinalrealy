  selectname: "\u201C\uC815\uC2E0 \uCC28\uB824, \uC6A9\uC0B0\uAD6C! \uB10C \uAD70\uC778\uC774\uACE0
    \uB09C \uC2DC\uC7A5\uC774\uC57C! \uC5EC\uAE30\uC11C \uB098\uAC08 \uC0DD\uAC01\uBD80\uD130
    \uD574!\u201D (\uB2E8\uD638\uD558\uAC8C \uD638\uD1B5\uCE58\uBA70 \uBC00\uCCD0\uB0B4\uB824
    \uD55C\uB2E4.) "
  th: 1
  iscorrect: 0
  selectedlog:
  - "#(\uC815\uC2E0\uC744 \uCC28\uB9AC\uAC8C \uD558\uB824\uACE0 \uC774\uC131\uC801\uC778
    \uC2E0\uBD84\uC744 \uC77C\uAE68\uC6E0\uC9C0\uB9CC, \uADF8 \uB2E8\uC5B4\uAC00
    \uADF8\uB140\uC758 \uC5ED\uB9B0\uC744 \uAC74\uB4DC\uB838\uB2E4.) \uC6A9\uC0B0\uAD6C
    : \u201C\uAD70\uC778\u2026\u2026 \uC2DC\uC7A5\u2026\u2026 \uB610 \uADF8 \uC9C0\uAE0B\uC9C0\uAE0B\uD55C
    \uACF5\uBB34(\u516C\u52D9) \uD0C0\uB839\uC774\uC57C?!\u201D "
  - "#(\uADF8\uB140\uC758 \uC190\uAC00\uB77D\uC5D0 \uBB34\uC11C\uC6B4 \uC545\uB825\uC774
    \uB4E4\uC5B4\uAC00\uBA70 \uB0B4 \uBAA9\uC744 \uAC15\uD558\uAC8C \uC9D3\uB204\uB978\uB2E4.
    \uCEE5, \uD558\uACE0 \uB9C9\uD78C \uC228\uC774 \uD130\uC838 \uB098\uC628\uB2E4.
    \uADF8\uB140\uC758 \uB208\uBB3C\uC774 \uB0B4 \uBEA8 \uC704\uB85C \uB69D\uB69D
    \uB5A8\uC5B4\uC9C0\uB294 \uAC83\uC774 \uB290\uAEF4\uC9C4\uB2E4.) "
  - "\u201C\uB09C \uC2DC\uC7A5\uB2D8\uC758 \u2018\uBD80\uD558\u2019\uAC00 \uC544\uB2C8\uB77C
    \u2018\uC804\uBD80\u2019\uAC00 \uB418\uACE0 \uC2F6\uB2E4\uACE0 \uBA87 \uBC88\uC744
    \uB9D0\uD574! \uB098\uD55C\uD14C\uC11C \uB3C4\uB9DD\uCE60 \uC0DD\uAC01\uB9CC
    \uD55C\uB2E4\uBA74\u2026\u2026 \uCC28\uB77C\uB9AC \uC5EC\uAE30\uC11C \uAC19\uC774
    \uC8FD\uC5B4!\u201D "
