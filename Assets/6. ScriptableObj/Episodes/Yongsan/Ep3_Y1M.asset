  selectname: "\u201C\uAC00\uB9CC\uD788 \uC788\uC5B4! \uBCBD\uC5D0 \uBA38\uB9AC \uCC27\uC73C\uBA74
    \uB2E4\uCE5C\uB2E4..!\u201D  (\uC190\uC804\uB4F1\uC744 \uCF1C\uC11C \uADF8\uB140\uC758
    \uC5BC\uAD74\uC5D0 \uC815\uBA74\uC73C\uB85C \uBE44\uCD98\uB2E4.) "
  th: 0
  iscorrect: 0
  selectedlog:
  - "#(\uC0C1\uD669\uC744 \uD30C\uC545\uD558\uAE30 \uC704\uD574 \uC190\uC804\uB4F1
    \uBD88\uBE5B\uC744 \uD655 \uBE44\uCDC4\uC9C0\uB9CC, \uAC11\uC791\uC2A4\uB7EC\uC6B4
    \uAC15\uD55C \uBE5B\uC774 \uACF5\uD669\uC5D0 \uBE60\uC9C4 \uADF8\uB140\uC758
    \uC2DC\uC2E0\uACBD\uC744 \uC790\uADF9\uD588\uB2E4.) "
  - "\u201C\uC544\uC545! \uB044\uC9C0 \uB9C8, \uC544\uB2C8, \uBE44\uCD94\uC9C0 \uB9C8\u2026\u2026!\u201D"
  - "#(\uC6A9\uC0B0\uAD6C\uB294 \uAD34\uC131\uC744 \uC9C0\uB974\uBA70 \uC190\uC804\uB4F1\uC744
    \uCCD0\uC11C \uB0A0\uB824\uBC84\uB9B0\uB2E4. \uCA0D\uADF8\uB791 \uC18C\uB9AC\uC640
    \uD568\uAED8 \uBD88\uBE5B\uC774 \uAE68\uC838\uB098\uAC00\uBA70 \uB2E4\uC2DC \uC644\uC804\uD55C
    \uC554\uD751\uC774 \uCC3E\uC544\uC628\uB2E4. \uADF8\uB140\uB294 \uBC30\uC2E0\uAC10\uACFC
    \uACF5\uD3EC\uB85C \uB4A4\uC11E\uC778 \uB208\uBB3C\uC744 \uD758\uB9AC\uBA70 \uBCBD
    \uAD6C\uC11D\uC73C\uB85C \uB354 \uD30C\uACE0\uB4E0\uB2E4.) "
  - "\u201C\uC2DC\uC7A5\uB2D8\uB3C4 \uB611\uAC19\uC544\u2026\u2026. \uB098\uB97C
    \uB611\uBC14\uB85C \uBCF4\uC9C0\uB3C4 \uC54A\uC73C\uBA74\uC11C, \uBA40\uB9AC\uC11C
    \uAD00\uC870\uD558\uB4EF \uAD6C\uACBD\uB9CC \uD558\uB824\uB294 \uAC70\uC9C0?!\u201D "
