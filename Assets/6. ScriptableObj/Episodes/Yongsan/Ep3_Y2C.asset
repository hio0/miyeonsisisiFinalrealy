  selectname: " \u201C\u2026\u2026\uADF8\uB798. \uAD6C\uC870\uB300 \uB530\uC708 \uC548
    \uC640\uB3C4 \uC88B\uC544. \uC5EC\uAE30\uC120 \uB108\uB9CC \uBCF4\uC774\uB2C8\uAE4C.\u201D
    #(\uADF8\uB140\uC758 \uC9D1\uCC29\uC5D0 \uB3D9\uC870\uD574\uC8FC\uBA70 \uC548\uC2EC\uC2DC\uD0A8\uB2E4.) "
  th: 1
  iscorrect: 1
  selectedlog:
  - "#(\uADF8\uB140\uC758 \uB4A4\uD2C0\uB9B0 \uB3C5\uC810\uC695\uC744 \uCC44\uC6CC\uC8FC\uC790,
    \uC5B4\uB460 \uC18D\uC5D0\uC11C \uC6A9\uC0B0\uAD6C\uC758 \uAC00\uC05C \uC228\uC18C\uB9AC\uAC00
    \uD669\uD640\uD55C \uD0C4\uC2DD\uC73C\uB85C \uBC14\uB010\uB2E4. \uADF8\uB140\uAC00
    \uB0B4 \uAC00\uC2B4\uD30D\uC5D0 \uBEA8\uC744 \uBE44\uBE44\uBA70 \uD789\uD789
    \uC6C3\uB294\uB2E4.) "
  - "\u201C\uC544\uD558\uD558\u2026\u2026 \uB4DC\uB514\uC5B4 \uB0B4 \uB9C8\uC74C\uC744
    \uC54C\uC544\uC8FC\uB294\uAD6C\uB098. \uB9DE\uC544, \uC6B0\uB9B0 \uD3C9\uC0DD
    \uC5EC\uAE30 \uB458\uC774\uC11C\uB9CC \uC369\uC5B4\uAC00\uB294 \uAC70\uC57C.
    \uB108\uBB34 \uD589\uBCF5\uD574, \uC2DC\uC7A5\uB2D8\u2026\u2026.\u201D "
  - "#(\uC704\uAE30\uB294 \uB118\uACBC\uC9C0\uB9CC, \uADF8\uB140\uC758 \uC190\uAC00\uB77D\uC774
    \uB0B4 \uBAA9\uC744 \uC870\uC5EC\uC624\uB294 \uD798\uC740 \uD480\uB9AC\uC9C0
    \uC54A\uB294\uB2E4. \uAD11\uC801\uC778 \uC560\uCC29\uC774 \uBC29\uC548\uC744
    \uC9C0\uBC30\uD55C\uB2E4.) "
