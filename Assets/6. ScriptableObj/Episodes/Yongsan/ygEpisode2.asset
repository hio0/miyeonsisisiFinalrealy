  m_Script: {fileID: 11500000, guid: d86ef726ec2bb1340be9fc0a470d9b84, type: 3}
  m_Name: ygEpisode2
  m_EditorClassIdentifier: 
  texts:
  - "`#(\uB2A6\uC740 \uBC24, \uC2DC\uC7A5 \uC9D1\uBB34\uC2E4. \uAC70\uCE60\uAC8C
    \uBB38\uC774 \uC5F4\uB9AC\uB294 \uC18C\uB9AC\uC640 \uD568\uAED8 \uAD70\uBCF5
    \uC790\uCF13\uC744 \uC5C9\uB9DD\uC73C\uB85C \uAC78\uCE5C \uC6A9\uC0B0\uAD6C\uAC00
    \uB4E4\uC774\uB2E5\uCCE4\uB2E4.) "
  - "`#(\uADF8\uB140\uC758 \uC228\uC18C\uB9AC\uB294 \uBE44\uC815\uC0C1\uC801\uC77C
    \uC815\uB3C4\uB85C \uAC00\uC058\uACE0 \uAC70\uCE60\uC5C8\uB2E4.) "
  - "`#( \uC190\uD1B1\uC744 \uB108\uBB34 \uB72F\uC5B4 \uD53C\uAC00 \uB9FA\uD78C \uC190\uC73C\uB85C
    \uC81C \uBAA9\uC744 \uC8C4\uC5B4\uC624\uB294 \uAD70\uBCF5 \uAE43\uC744 \uB72F\uC5B4\uB0B4\uB4EF
    \uD480 \uD5E4\uCE58\uACE0 \uC788\uC5C8\uB2E4.) "
  - "[tired] \u201C\uD558\uC544\u2026\u2026 \uD558\uC73D\u2026\u2026 \uC2DC, \uC2DC\uC7A5\uB2D8\u2026\u2026.\u201D "
  - "`#(\uCD08\uC810 \uC5C6\uB294 \uB208\uB3D9\uC790\uAC00 \uC0AC\uC815\uC5C6\uC774
    \uD754\uB4E4\uB9AC\uACE0 \uC788\uC5C8\uB2E4.) "
  - "`#(\uC8FC\uBCC0\uC758 \uAE09\uACA9\uD55C \uAC1C\uBC1C\uACFC \uBCC0\uD654\uB97C
    \uBC84\uD2F0\uC9C0 \uBABB\uD558\uACE0 \uACF5\uD669 \uBC1C\uC791\uC774 \uCC3E\uC544\uC628
    \uAC83\uC774 \uBD84\uBA85\uD588\uB2E4.) "
  - "`#(\uADF8\uB140\uB294 \uBE44\uD2C0\uAC70\uB9AC\uBA70 \uB0B4 \uCC45\uC0C1 \uC55E\uAE4C\uC9C0
    \uC640\uC11C\uB294 \uADF8\uB300\uB85C \uBB34\uB108\uC9C0\uB4EF \uBC14\uB2E5\uC5D0
    \uC8FC\uC800\uC549\uC544 \uBA38\uB9AC\uB97C \uAC10\uC2F8 \uC950\uC5C8\uB2E4.) "
  - "`#(\uADF8\uB140\uB294 \uBE44\uD2C0\uAC70\uB9AC\uBA70 \uB0B4 \uCC45\uC0C1 \uC55E\uAE4C\uC9C0
    \uC640\uC11C\uB294 \uADF8\uB300\uB85C \uBB34\uB108\uC9C0\uB4EF \uBC14\uB2E5\uC5D0
    \uC8FC\uC800\uC549\uC544 \uBA38\uB9AC\uB97C \uAC10\uC2F8 \uC950\uC5C8\uB2E4.) "
  - "[menhea]\u201C\uC0AC\uB77C\uC838\u2026\u2026 \uB0B4\uAC00 \uC54C\uB358 \uAC70\uB9AC\uAC00,
    \uC0AC\uB78C\uB4E4\uC774, \uC804\uBD80 \uC21C\uC2DD\uAC04\uC5D0 \uD754\uC801\uB3C4
    \uC5C6\uC774 \uC0AC\uB77C\uC9C4\uB2E4\uACE0\u2026\u2026!\u201D"
  - "[menhera]\u201D\uB098\uB3C4 \uADF8\uB807\uAC8C \uBC84\uB824\uC9C8 \uAC70\uC57C.
    \uC544\uBB34\uB3C4 \uB0A0 \uC548 \uBD10\uC918\u2026\u2026 \uC228\uC774, \uC228\uC774
    \uC548 \uC26C\uC5B4\uC838\u2026\u2026!\u201D"
  - "*#(\uACFC\uD638\uD761\uC73C\uB85C \uBD89\uC5B4\uC9C4 \uC5BC\uAD74\uACFC \uB208\uBB3C\uB85C
    \uBC94\uBC85\uC774 \uB41C \uCC44 \uB5A8\uACE0 \uC788\uB294 \uAD70\uC778. \uC774
    \uC704\uD0DC\uB85C\uC6B4 \uC0C1\uD669\uC5D0\uC11C \uB098\uB294 \uCCAB \uBC88\uC9F8
    \uD589\uB3D9\uC744 \uCDE8\uD574\uC57C \uD55C\uB2E4.)"
  - "`#(\uC6A9\uC0B0\uAD6C\uB294 \uB0B4 \uC637\uC790\uB77D\uC744 \uCC22\uC5B4\uC9C8
    \uB4EF \uAF49 \uC950\uBA70 \uC5BC\uAD74\uC744 \uB4E4\uC774\uBC00\uC5C8\uB2E4.)  "
  - "`#(\uC9C8\uC2DD\uD560 \uAC83 \uAC19\uC740 \uC9D1\uCC29\uC758 \uC544\uC6B0\uB77C\uAC00
    \uBC29\uC548\uC744 \uAC00\uB4DD \uCC44\uC6E0\uB2E4.) "
  - "[menhera]\u201C\uC57D\uC18D\uD574\uC918\u2026\u2026. \uB2E4\uB978 \uAD6C(\u5340)
    \uB3D9\uC0DD\uB4E4 \uBCF4\uB7EC \uAC00\uC9C0 \uC54A\uACA0\uB2E4\uACE0. \uB098\uB9CC
    \uBCF4\uACA0\uB2E4\uACE0 \uD574\uC918. \uC2DC\uC7A5\uB2D8\uB9C8\uC800 \uB0A0
    \uD63C\uC790 \uB450\uBA74\u2026\u2026 \uB098 \uC815\uB9D0 \uBB34\uC2A8 \uC9D3\uC744
    \uC800\uC9C0\uB97C\uC9C0 \uBAB0\uB77C. \uC751? \uBE68\uB9AC \uB300\uB2F5\uD574\uC918\u2026\u2026.\u201D"
  - "*#(\uADF8\uB140\uC758 \uB208\uB3D9\uC790 \uAE4A\uC740 \uACF3\uC5D0\uC11C \uAC70\uB300\uD55C
    \uC2EC\uC5F0\uC774 \uC77C\uB801\uC600\uB2E4. \uD655\uB2F5\uC744 \uC8FC\uC9C0
    \uC54A\uC73C\uBA74 \uC815\uB9D0\uB85C \uC704\uD5D8\uD574\uC9C8 \uAC83 \uAC19\uC740
    \uC21C\uAC04, \uB9C8\uC9C0\uB9C9 \uC120\uD0DD\uC758 \uAE30\uB85C\uC5D0 \uC130\uB2E4.
    \uBB34\uC5C7\uC744 \uD0DD\uD574\uC57C\uD560\uAE4C?)"
  selects:
