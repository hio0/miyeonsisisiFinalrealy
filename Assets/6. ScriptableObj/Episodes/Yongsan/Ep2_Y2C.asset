  selectname: "\u201C\uADF8\uB798, \uC57D\uC18D\uD560\uAC8C. \uB124 \uACC1\uC5D0
    \uC788\uC744 \uD14C\uB2C8\uAE4C \uC548\uC2EC\uD574.\u201D (\uADF8\uB140\uAC00
    \uC6D0\uD558\uB294 \uB300\uB2F5\uC744 \uC8FC\uBA70 \uC548\uC2EC\uC2DC\uD0A8\uB2E4.) "
  th: 1
  iscorrect: 1
  selectedlog:
  - "#(\uC6B0\uC120\uC740 \uADF8\uB140\uB97C \uC0B4\uB824\uC57C \uD55C\uB2E4\uB294
    \uC0DD\uAC01\uC5D0 \uAC08\uAD6C\uD558\uB294 \uB300\uB2F5\uC744 \uAC74\uB138\uB2E4.
    \uADF8 \uB9D0\uC744 \uB4E4\uC740 \uC6A9\uC0B0\uAD6C\uC758 \uC5BC\uAD74\uC5D0
    \uC18C\uB984 \uB07C\uCE60 \uC815\uB3C4\uB85C \uD654\uC0AC\uD558\uACE0 \uC544\uB984\uB2E4\uC6B4
    \uBBF8\uC18C\uAC00 \uD53C\uC5B4\uB0AC\uB2E4.)  "
  - "\u201C\uC544\uD558\uD558\u2026\u2026 \uC9C4\uC9DC\uC9C0? \uAC70\uC9D3\uB9D0\uD558\uBA74
    \uC548 \uB3FC? \uB9CC\uC57D \uAC70\uC9D3\uB9D0\uC774\uBA74\u2026\u2026 \uC2DC\uC7A5\uB2D8
    \uB2E4\uB9AC\uB97C \uBD80\uB7EC\uB728\uB824\uC11C\uB77C\uB3C4 \uB0B4 \uACC1\uC5D0
    \uAC00\uB46C\uB458 \uAC70\uB2C8\uAE4C.\u201D "
  - "#(\uB2EC\uCF64\uD558\uBA74\uC11C\uB3C4 \uC624\uC2F9\uD55C \uC9D1\uCC29\uC758
    \uB9D0\uC744 \uC18D\uC0AD\uC774\uBA70, \uADF8\uB140\uB294 \uB0B4 \uD488\uC5D0
    \uC644\uC804\uD788 \uAE30\uB300\uC5B4 \uACE4\uD788 \uC7A0\uB4E4\uC5C8\uB2E4.
    \uC704\uAE30\uB294 \uB118\uACBC\uC9C0\uB9CC, \uBB34\uC5B8\uAC00 \uC798\uBABB\uB41C
    \uACC4\uC57D\uC744 \uB9FA\uC740 \uAE30\uBD84\uC774\uB2E4.) "
