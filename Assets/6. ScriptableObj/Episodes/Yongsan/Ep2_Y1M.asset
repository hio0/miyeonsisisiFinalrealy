  selectname: "\u201C\uBE44\uC11C\uC2E4! \uC9C0\uAE08 \uB2F9\uC7A5 \uC758\uB8CC\uC9C4
    \uBD88\uB7EC!\u201D (\uC790\uB9AC\uC5D0\uC11C \uC77C\uC5B4\uB098 \uC778\uD130\uD3F0\uC744
    \uC7A1\uB294\uB2E4.) "
  th: 0
  iscorrect: 0
  selectedlog:
  - "#(\uC804\uBB38\uC801\uC778 \uB3C4\uC6C0\uC774 \uD544\uC694\uD558\uB2E4\uB294
    \uD310\uB2E8\uC5D0 \uADF8\uB140\uC5D0\uAC8C\uC11C \uAC70\uB9AC\uB97C \uB450\uBA70
    \uC778\uD130\uD3F0\uC744 \uC7A1\uC558\uB2E4. \uD558\uC9C0\uB9CC \uADF8 \uD589\uB3D9\uC774
    \uADF8\uB140\uC5D0\uAC8C\uB294 \u2018\uAC70\uC808\u2019\uC774\uC790 \u2018\uBC84\uB824\uC9D0\u2019\uC73C\uB85C
    \uB2E4\uAC00\uC628 \uB4EF\uD588\uB2E4.)  "
  - "\u201C\u2026\u2026\uC2EB\uC5B4.\u201D "
  - "#\u201C\uC5B4\u2026\u2026?\u201D "
  - "#(\uC778\uD130\uD3F0\uC744 \uB4E0 \uB0B4 \uC190\uBAA9\uC744 \uC6A9\uC0B0\uAD6C\uAC00
    \uBB34\uC11C\uC6B4 \uC545\uB825\uC73C\uB85C \uB09A\uC544\uCC44 \uBC14\uB2E5\uC73C\uB85C
    \uB0B4\uD33D\uAC1C\uCCE4\uB2E4. \uCF70\uC7A5\uCC3D \uD558\uB294 \uC18C\uB9AC\uC640
    \uD568\uAED8 \uC778\uD130\uD3F0\uC774 \uBC15\uC0B4 \uB0AC\uB2E4. \uC548\uADF8\uB798\uB3C4
    \uC8FD\uC5B4\uC788\uB358 \uADF8\uB140\uC758 \uC2DC\uC120\uC774, \uC774\uC81C\uB294
    \uC644\uC804\uD788 \uCD08\uC810\uC744 \uC783\uACE0 \uAD11\uAE30\uC5D0 \uBB3C\uB4E4\uC5B4
    \uC788\uC5C8\uB2E4.)"
  - " \u201C\uC758\uC0AC \uB530\uC708 \uD544\uC694 \uC5C6\uC5B4\u2026\u2026 \uC2DC\uC7A5\uB2D8\uB3C4
    \uB0A0 \uBC84\uB9AC\uB294\uAD6C\uB098? \uADC0\uCC2E\uC740 \uC9D0\uC9DD \uCDE8\uAE09\uD558\uBA74\uC11C
    \uBC00\uC5B4\uB0B4\uB294 \uAC70\uC9C0? \uADF8\uB807\uC9C0?!\u201D "
