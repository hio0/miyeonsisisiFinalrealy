  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d86ef726ec2bb1340be9fc0a470d9b84, type: 3}
  m_Name: ygEpisode3
  m_EditorClassIdentifier: 
  texts:
  - "`#(\uC11C\uC6B8\uC2DC \uC0B0\uD558\uC758 \uC624\uB798\uB41C \uC9C0\uD558 \uB300\uD53C\uC18C\uC5D0
    \uC2DC\uC124 \uC810\uAC80\uC744 \uD558\uB7EC \uB098\uC628 \uB0A0.) "
  - "`#(\uAC11\uC790\uAE30 \uBC1C\uC0DD\uD55C \uB178\uD6C4 \uCC28\uB2E8\uAE30 \uACB0\uD568\uC73C\uB85C
    \uCF70\uB974\uB989- \uD558\uB294 \uAD49\uC74C\uACFC \uD568\uAED8 \uC154\uD130\uAC00
    \uB0B4\uB824\uC549\uC73C\uBA70 \uC9C0\uD558 \uACF5\uAC04\uC5D0 \uAC07\uD788\uACE0
    \uB9CC\uB2E4.)"
  - "`#(\uBE44\uC0C1 \uC804\uB825\uB9C8\uC800 \uB098\uAC00 \uC0AC\uBC29\uC774 \uCE60\uD751
    \uAC19\uC740 \uC5B4\uB460\uACFC \uC9C0\uB3C5\uD55C \uD3D0\uC1C4\uAC10\uC5D0 \uC9D3\uB20C\uB9AC\uB294
    \uC21C\uAC04, \uC606\uC5D0 \uC788\uB358 \uC6A9\uC0B0\uAD6C\uC758 \uC228\uC18C\uB9AC\uAC00
    \uBE44\uC815\uC0C1\uC801\uC73C\uB85C \uAC70\uCE60\uC5B4\uC9C0\uAE30 \uC2DC\uC791\uD55C\uB2E4.)"
  - "[menhera]\u201C\uD558\uC544\u2026\u2026 \uD763, \uD558\uC544\u2026\u2026 \uBB34,
    \uBB38\uC774\u2026\u2026 \uC548 \uC5F4\uB824\u2026\u2026.\u201D"
  - "`#(\uC0AC\uBC29\uC774 \uAF49 \uB9C9\uD78C \uC5B4\uB460\uACFC \uAC07\uD614\uB2E4\uB294
    \uC2EC\uB9AC\uC801 \uC555\uBC15\uAC10\uC774 \uADF8\uB140\uC758 \uACF5\uD669\uC7A5\uC560\uB97C
    \uC815\uBA74\uC73C\uB85C \uC790\uADF9\uD588\uB2E4.) "
  - "`#(\uC8FC\uBCC0\uC758 \uAE09\uACA9\uD55C \uAC1C\uBC1C\uACFC \uBCC0\uD654\uB97C
    \uBC84\uD2F0\uC9C0 \uBABB\uD558\uACE0 \uACF5\uD669 \uBC1C\uC791\uC774 \uCC3E\uC544\uC628
    \uAC83\uC774 \uBD84\uBA85\uD588\uB2E4.) "
  - "`#(\uADF8\uB140\uB294 \uBE44\uD2C0\uAC70\uB9AC\uBA70 \uB0B4 \uCC45\uC0C1 \uC55E\uAE4C\uC9C0
    \uC640\uC11C\uB294 \uADF8\uB300\uB85C \uBB34\uB108\uC9C0\uB4EF \uBC14\uB2E5\uC5D0
    \uC8FC\uC800\uC549\uC544 \uBA38\uB9AC\uB97C \uAC10\uC2F8 \uC950\uC5C8\uB2E4.) "
  - "`#(\uAC15\uC778\uD558\uB358 \uAD70\uC778\uC758 \uBAA8\uC2B5\uC740 \uC628\uB370\uAC04\uB370\uC5C6\uC774,
    \uADF8\uB140\uB294 \uBC14\uB2E5\uC5D0 \uC8FC\uC800\uC549\uC544 \uC81C \uAC00\uC2B4\uC744
    \uC950\uC5B4\uB72F\uC73C\uBA70 \uBCBD\uC5D0 \uBA38\uB9AC\uB97C \uCFF5\uCFF5 \uCC27\uAE30
    \uC2DC\uC791\uD55C\uB2E4. )"
  - "`#(\uC190\uD1B1\uC744 \uB72F\uB290\uB77C \uB9FA\uD78C \uD53C\uAC00 \uC5B4\uB460
    \uC18D\uC5D0\uC11C\uB3C4 \uB290\uAEF4\uC9C8 \uC815\uB3C4\uB2E4.) "
  - "[tired]\u201C\uC5EC\uAE34 \uAC07\uD614\uC5B4\u2026\u2026. \uC544\uBB34\uB3C4
    \uC6B0\uB9AC \uC548 \uCC3E\uC544\uC640. \uB2E4\uB4E4 \uC6B0\uB9B4 \uC78A\uACE0
    \uB450\uACE0 \uAC08 \uAC70\uC57C.\""
  - "[menhera]\"\uB098\uCC98\uB7FC\u2026\u2026 \uB098\uCC98\uB7FC \uC804\uBD80 \uBC84\uB824\uC9C0\uB294
    \uAC70\uB77C\uACE0! \uC228\uC774\u2026\u2026 \uC228\uC774 \uC548 \uC26C\uC5B4\uC838,
    \uC2DC\uC7A5\uB2D8\u2026\u2026!\u201D"
  - "*#(\uADF8\uB7F0 \uADF8\uB140\uB97C \uC704\uD574 \uB098\uB294 \uC5B4\uB5A4 \uD589\uB3D9\uC744
    \uCDE8\uD574\uC57C\uD560\uAE4C?)"
  - "`#(\uC5B4\uB460 \uC18D\uC5D0\uC11C \uACA8\uC6B0 \uC228\uC744 \uACE0\uB974\uB358
    \uC6A9\uC0B0\uAD6C\uAC00, \uAC11\uC790\uAE30 \uB0B4 \uC190\uBAA9\uC744 \uB09A\uC544\uCC44\uB354\uB2C8
    \uADF8\uB300\uB85C \uBC14\uB2E5\uC5D0 \uB098\uB97C \uBC00\uCCD0 \uB215\uD78C\uB2E4.) "
  - "`#(\uB300\uD53C\uC18C \uBC14\uB2E5\uC758 \uCC28\uAC00\uC6B4 \uAC10\uCD09\uACFC
    \uD568\uAED8, \uB0B4 \uBAB8 \uC704\uB85C \uC62C\uB77C\uD0C4 \uADF8\uB140\uC758
    \uB728\uAC81\uACE0 \uCD95\uCD95\uD55C \uD638\uD761\uC774 \uC5BC\uAD74\uB85C \uC3DF\uC544\uC9C4\uB2E4.
    \uADF8\uB140\uB294 \uB0B4 \uBAA9\uB35C\uBBF8\uC5D0 \uC190\uAC00\uB77D\uC744 \uC0B4\uBA70\uC2DC
    \uAC00\uC838\uB2E4 \uB300\uBA70 \uC18D\uC0AD\uC778\uB2E4.)"
  - "*#(\uADF8\uB140\uC758 \uB208\uB3D9\uC790 \uAE4A\uC740 \uACF3\uC5D0\uC11C \uAC70\uB300\uD55C
    \uC2EC\uC5F0\uC774 \uC77C\uB801\uC600\uB2E4. \uD655\uB2F5\uC744 \uC8FC\uC9C0
    \uC54A\uC73C\uBA74 \uC815\uB9D0\uB85C \uC704\uD5D8\uD574\uC9C8 \uAC83 \uAC19\uC740
    \uC21C\uAC04, \uB9C8\uC9C0\uB9C9 \uC120\uD0DD\uC758 \uAE30\uB85C\uC5D0 \uC130\uB2E4.
    \uBB34\uC5C7\uC744 \uD0DD\uD574\uC57C\uD560\uAE4C?)"
  - "[menhera]\u201C\uC2DC\uC7A5\uB2D8\u2026\u2026 \uB098.. \uC2DC\uC7A5\uB2D8 \uB54C\uBB38\uC5D0
    \uBBF8\uCE60 \uAC83 \uAC19\uC544\u2026 \uB108\uBB34 \uCE5C\uC808\uD574\uC11C
    \uACC4\uC18D \uAE30\uB300\uACE0 \uC2F6\uC796\uC544..\u201D"
  - "[menhera] \u201C\uD558\uC9C0\uB9CC.. \uBC16\uC5D0 \uB098\uAC00\uBA74 \uC2DC\uC7A5\uB2D8\uC740
    \uB2E4\uB978 \uAD6C(\u5340) \uC544\uC774\uB4E4\uC744 \uBCF4\uB290\uB77C \uBC14\uC058\uC796\uC544.\u201D "
  - "[menhera]\u201C\uD558\uC9C0\uB9CC \uC5EC\uAE30\uC120\u2026\u2026 \uC2DC\uC7A5\uB2D8
    \uB208\uC5D0 \uB098\uBC16\uC5D0 \uC548 \uBCF4\uC774\uC796\uC544. \uB098\uB9CC
    \uAC00\uC9C8 \uC218 \uC788\uC796\uC544\u2026\u2026.\u201D"
  - "`#(\uC9C0\uD558\uC758 \uD3D0\uC1C4 \uACF5\uAC04\uC774 \uADF8\uB140\uC758 \uACF5\uD669
    \uC7A5\uC560\uB97C \uCD5C\uC545\uC758 \uBC29\uD5A5\uC778 \uC9D1\uCC29\uC73C\uB85C
    \uBE44\uD2C0\uC5B4\uBC84\uB838\uB2E4.) "
  - "*#(\uB098\uB97C \uB0B4\uB824\uB2E4\uBCF4\uB294 \uADF8\uB140\uC5D0\uAC8C \uB450
    \uBC88\uC9F8 \uB300\uB2F5\uC744 \uD574\uC57C \uD55C\uB2E4.)"
  - "`#(\uADF8\uB54C, \uBA40\uB9AC\uC11C \uC9C0\uC9C0\uC9C1- \uD558\uB294 \uC18C\uB9AC\uC640
    \uD568\uAED8 \uBE44\uC0C1 \uC2A4\uD53C\uCEE4\uB97C \uD1B5\uD574 \uC678\uBD80
    \uAD6C\uC870\uB300\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uD76C\uBBF8\uD558\uAC8C \uD758\uB7EC\uB098\uC624\uAE30
    \uC2DC\uC791\uD55C\uB2E4.)  "
  - "`#(\u201C\uC2DC\uC7A5\uB2D8! \uC548\uC5D0 \uACC4\uC2ED\uB2C8\uAE4C! \uC9C0\uAE08
    \uAC1C\uBC29 \uC7A5\uCE58\uB97C \uC870\uC791 \uC911\uC785\uB2C8\uB2E4!\u201D) "
  - "`#(\uBB38\uC774 \uC5F4\uB9AC\uAE30\uAE4C\uC9C0 \uB0A8\uC740 \uC2DC\uAC04\uC740
    \uB2E8 \uBA87 \uBD84.) "
  - "`#(\uC6A9\uC0B0\uAD6C\uB294 \uD5C8\uB9AC\uCDA4\uC5D0\uC11C \uC81C\uB840\uC2DD
    \uB2E8\uAC80\uC744 \uC2A4\uB974\uB975 \uBF51\uC544 \uB4E4\uB354\uB2C8, \uB0B4
    \uC2EC\uC7A5 \uBC14\uB85C \uC704\uC5D0 \uCE7C\uB0A0\uC744 \uAC16\uB2E4 \uB300\uBA70
    \uC6B8\uBD80\uC9D6\uB294\uB2E4.) "
  - "`#\u201C\uC800 \uBB38\uC774 \uC5F4\uB9AC\uBA74 \uC2DC\uC7A5\uB2D8\uC740 \uB2E4\uC2DC
    \uB0B4 \uC190\uC774 \uB2FF\uC9C0 \uC54A\uB294 \uB192\uC740 \uACF3\uC73C\uB85C
    \uAC00\uBC84\uB9AC\uACA0\uC9C0. \uC2EB\uC5B4\u2026\u2026\""
  - "[menhera]\"\uADF8\uB807\uAC8C \uB458 \uBC14\uC5D4, \uC2DC\uC7A5\uB2D8\uC744
    \uC2EC\uC7A5\uC744 \uCC14\uB7EC\uC11C \uC601\uC6D0\uD788 \uB0B4 \uAC78\uB85C
    \uBC15\uC81C\uD558\uACA0\uC5B4.\" "
  - "[menhera]\"\uC544\uB2C8\uBA74\u2026\u2026 \uB0B4\uAC00 \uC9C0\uAE08 \uC5EC\uAE30\uC11C
    \uC8FD\uC744\uAE4C? \uB300\uB2F5\uD574, \uC2DC\uC7A5\uB2D8\u2026\u2026!\u201D "
  - "*#(\uBB38\uC774 \uC5F4\uB9AC\uAE30 \uC9C1\uC804\uC758 \uCC30\uB098, \uCE7C\uC744
    \uB4E0 \uCC44 \uAD11\uAE30\uC5D0 \uCC28\uC11C \uC885\uCC29\uC5ED\uC5D0 \uB2E4\uB2E4\uB978
    \uADF8\uB140\uB97C \uB9C9\uAE30 \uC704\uD55C \uC138 \uBC88\uC9F8 \uCD5C\uC885
    \uC120\uD0DD\uC744 \uB0B4\uB824\uC57C \uD55C\uB2E4.) "
  selects:
  - {fileID: 11400000, guid: 55bf614e515df224487223a76c54e6b5, type: 2}
  - {fileID: 11400000, guid: b629930e5bf2cfd40ba7f98208eeeaf9, type: 2}
  - {fileID: 11400000, guid: 6eec65fd13f140f43a11d9eea93f16e8, type: 2}
  - {fileID: 11400000, guid: 114c15372620d9647bc9689187abc365, type: 2}
  - {fileID: 11400000, guid: 164223c147fd1e243aa952039d6891c9, type: 2}
