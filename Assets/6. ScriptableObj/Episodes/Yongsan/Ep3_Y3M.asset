  m_Script: {fileID: 11500000, guid: 00e1018d78f20f54d8f56740326b35c6, type: 3}
  m_Name: Ep3_Y3M
  m_EditorClassIdentifier: 
  selectname: "\u201C\uAD6C\uC870\uB300! \uC5EC\uAE30\uB2E4! \uB2F9\uC7A5 \uC774
    \uC815\uC2E0 \uC774\uC0C1\uC790\uB97C \uB0B4 \uBAB8 \uC704\uC5D0\uC11C \uB5BC\uC5B4\uB0B4!\u201D
    (\uC2A4\uD53C\uCEE4\uB97C \uD5A5\uD574 \uBAA9\uC774 \uD130\uC838\uB77C \uBE44\uBA85\uC744
    \uC9C0\uB974\uBA70 \uB3C4\uC6C0\uC744 \uC694\uCCAD\uD55C\uB2E4.) "
  th: 2
  iscorrect: 0
  selectedlog:
  - "#(\uBE44\uBA85 \uC18C\uB9AC\uB97C \uB4E4\uC740 \uAD6C\uC870\uB300\uC6D0\uB4E4\uC774
    \uC808\uB2E8\uAE30\uB85C \uC154\uD130\uB97C \uBD80\uC218\uACE0 \uC21C\uC2DD\uAC04\uC5D0
    \uBC29\uACF5\uD638 \uC548\uC73C\uB85C \uB4E4\uC774\uB2E5\uCE5C\uB2E4.)"
  - "#( \uAC15\uD55C \uC5F0\uB9C9\uD0C4 \uBD88\uBE5B \uC18D\uC5D0\uC11C \uC694\uC6D0\uB4E4\uC5D0\uAC8C
    \uC81C\uC555\uB2F9\uD574 \uBC14\uB2E5\uC5D0 \uB20C\uB9AC\uB294 \uC21C\uAC04\uC5D0\uB3C4,
    \uC6A9\uC0B0\uAD6C\uB294 \uD5DD\uD074\uC5B4\uC9C4 \uBA38\uB9AC\uCE7C \uC0AC\uC774\uB85C
    \uD53C\uB208\uBB3C\uC774 \uD750\uB97C \uB4EF\uD55C \uC2DC\uC120\uC73C\uB85C \uB098\uB97C
    \uB178\uB824\uBCF8\uB2E4.) "
  - "\u201C\uB098\uB97C\u2026\u2026 \u2018\uC815\uC2E0\uC774\uC0C1\uC790\u2019\uB77C\uACE0
    \uBD88\uB800\uC5B4\u2026\u2026? \uC78A\uC9C0 \uB9C8, \uC2DC\uC7A5\uB2D8. \uB0B4
    \uAD6C\uC5ED\uC5D0\uC11C \uB098\uAC04 \uAC78 \uCD95\uD558\uD574. \uB2E4\uC74C\uC5D4\u2026\u2026
    \uC2DC\uC7A5\uC2E4\uC774 \uB124 \uBB34\uB364\uC774 \uB420 \uD14C\uB2C8\uAE4C.\u201D"
  - "#(\uADF8\uB140\uB294 \uC694\uC6D0\uB4E4\uC5D0\uAC8C \uAC15\uC81C\uB85C \uC555\uC1A1\uB418\uC5B4
    \uAC00\uACE0, \uB3C5\uAE30\uC640 \uC6D0\uB9DD\uC73C\uB85C \uAC00\uB4DD \uCC2C
    \uADF8\uB140\uC758 \uACBD\uACE0\uAC00 \uBA38\uB9BF\uC18D\uC744 \uCC28\uAC11\uAC8C
    \uC5BC\uC5B4\uBD99\uAC8C \uB9CC\uB4E0\uB2E4.) "
