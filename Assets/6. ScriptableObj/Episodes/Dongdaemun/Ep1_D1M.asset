  m_Name: Ep1_D1M
  m_EditorClassIdentifier: 
  selectname: "\u201C\uB2F9\uC7A5 \uC778\uB3C4 \uC704\uB85C \uC62C\uB77C\uC624\uC9C0
    \uBABB\uD574! \uADF8\uB7F0 \uC0BC\uB958 \uAC70\uC9D3\uB9D0\uACFC \uC1FC\uC5D0
    \uB0B4\uAC00 \uB180\uC544\uB0A0 \uAC83 \uAC19\uB098!\u201D #(\uCC28\uAC11\uAC8C
    \uC18C\uB9AC\uCE58\uBA70 \uADF8\uB140\uAC00 \uC2A4\uC2A4\uB85C \uBB3C\uB7EC\uB098\uB3C4\uB85D
    \uB2E8\uD638\uD558\uAC8C \uC120\uC744 \uAE0B\uB294\uB2E4.)"
  th: 0
  iscorrect: 0
  selectedlog:
  - "#(\uB0B4 \uCC28\uAC00\uC6B4 \uD638\uD1B5\uC5D0 \uB180\uB780 \uB3D9\uB300\uBB38\uAD6C\uAC00
    \uAE09\uD788 \uB4A4\uB85C \uBB3C\uB7EC\uC120\uB2E4.) ##(\uD2B8\uB7ED\uC774 \uC544\uC2AC\uC544\uC2AC\uD558\uAC8C
    \uADF8\uB140\uC758 \uCF54\uC55E\uC744 \uC9C0\uB098\uAC04\uB2E4.) "
  - "#(\uACA8\uC6B0 \uBAA9\uC228\uC740 \uAC74\uC84C\uC9C0\uB9CC, \uB0B4 \uB0C9\uC815\uD55C
    \uBC18\uC751\uC774 \uADF8\uB140\uC758 \uAC70\uB300\uD55C \uACB0\uD54D\uC744 \uC815\uBA74\uC73C\uB85C
    \uCC14\uB800\uB2E4.) "
  - " \u201C\uC1FC\u2026\u2026? \uC0BC\uB958 \uAC70\uC9D3\uB9D0\u2026\u2026? \uC544\uD558\uD558,
    \uC5ED\uC2DC \uADF8\uB807\uAD6C\uB098. \uB208\uCE58 \uBE60\uB974\uC2E0 \uC2DC\uC7A5\uB2D8
    \uB208\uC5D4 \uB0B4\uAC00 \uC5BC\uB9C8\uB098 \uC6B0\uC2A4\uC6E0\uC744\uAE4C?\u201D "
  - "#(\uADF8\uB140\uB294 \uAE7B\uC78E\uBA38\uB9AC \uC0AC\uC774\uB85C \uB208\uBB3C
    \uBC94\uBC85\uC774 \uB41C \uC5BC\uAD74\uC744 \uB4DC\uB7EC\uB0B4\uBA70 \uC2F8\uB298\uD558\uAC8C
    \uC6C3\uB294\uB2E4.) ##(\uD654\uB824\uD558\uAC8C \uBC18\uC9DD\uC774\uB358 \uBC18\uC9C0\uB97C
    \uBE7C\uC11C \uBC14\uB2E5\uC5D0 \uB0B4\uD33D\uAC1C\uCE5C\uB2E4.) "
  - "#(\uBD84\uD64D\uC0C9 \uB2E8\uBC1C\uBA38\uB9AC\uB97C \uD769\uB0A0\uB9AC\uBA70
    \uCCAD\uB7C9\uB9AC\uC5ED\uC758 \uC5B4\uB450\uC6B4 \uB178\uC810\uC0C1 \uACE8\uBAA9
    \uB108\uBA38\uB85C \uB3C4\uB9DD\uCE58\uB4EF \uC0AC\uB77C\uC838 \uBC84\uB9B0\uB2E4.) "
  - " \u201C\uB2E4\uC2DC\uB294 \uB0B4 \uB208\uC55E\uC5D0 \uB098\uD0C0\uB098\uC9C0
    \uB9C8\uC694. \uC704\uC120\uC790 \uAC19\uC740 \uC2DC\uC7A5\uB2D8\uB3C4, \uC774
    \uD55C\uC2EC\uD55C \uB3D9\uB300\uBB38\uAD6C \uAD6C\uC11D\uB3C4 \uB2E4 \uAF34
    \uBCF4\uAE30 \uC2EB\uC73C\uB2C8\uAE4C!\u201D "
