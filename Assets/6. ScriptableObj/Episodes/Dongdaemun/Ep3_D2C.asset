  m_Name: Ep3_D2C
  m_EditorClassIdentifier: 
  selectname: "\u201C\u2026\u2026\uC88B\uC544. \uC2DC\uC7A5 \uC790\uB9AC\uB4E0 \uBC14\uAE65\uC138\uC0C1\uC774\uB4E0
    \uB2E4 \uD544\uC694 \uC5C6\uC5B4. \uCC28\uB77C\uB9AC \uC774\uB807\uAC8C \uC601\uC6D0\uD788
    \uB124\uAC8C \uBB36\uC5EC\uC11C \uAD6C\uC18D\uB418\uACA0\uB2E4.\u201D (\uADF8\uB140\uC758
    \uB4A4\uD2C0\uB9B0 \uB3C5\uC810\uC695\uC744 \uC628\uC804\uD788 \uBC1B\uC544\uB4E4\uC774\uBA70
    \uB728\uAC70\uC6B4 \uBC14\uB2E5\uC5D0 \uD568\uAED8 \uC8FC\uC800\uC549\uB294\uB2E4.) "
  th: 1
  iscorrect: 1
  selectedlog:
  - "#(\uC790\uC2E0\uACFC \uD568\uAED8 \uBAA8\uB4E0 \uAC83\uC744 \uD0DC\uC6B0\uACA0\uB2E4\uB294
    \uC120\uC5B8\uC744 \uB4E3\uC790, \uB3D9\uB300\uBB38\uAD6C\uC758 \uC0B4\uAE30
    \uC5B4\uB9B0 \uB208\uBE5B\uC774 \uC21C\uAC04 \uD669\uD640\uD55C \uC548\uB3C4\uAC10\uC73C\uB85C
    \uD480\uB824\uBC84\uB9B0\uB2E4.) #(\uC790\uC2E0\uACFC \uD568\uAED8 \uBAA8\uB4E0
    \uAC83\uC744 \uD0DC\uC6B0\uACA0\uB2E4\uB294 \uC120\uC5B8\uC744 \uB4E3\uC790,
    \uB3D9\uB300\uBB38\uAD6C\uC758 \uC0B4\uAE30 \uC5B4\uB9B0 \uB208\uBE5B\uC774 \uC21C\uAC04
    \uD669\uD640\uD55C \uC548\uB3C4\uAC10\uC73C\uB85C \uD480\uB824\uBC84\uB9B0\uB2E4.) "
  - "#(\uADF8\uB140\uAC00 \uC0AC\uC2AC \uCC2C \uBC1C\uC744 \uB0B4 \uBC1C \uACC1\uC73C\uB85C
    \uBAA8\uC73C\uBA70 \uAC00\uC058\uAC8C \uC6C3\uB294\uB2E4.)"
  - "\u201C\uC544\uD558\uD558\u2026\u2026 \uB4DC\uB514\uC5B4 \uB0B4 \uAC00\uCE58\uB97C
    \uC54C\uC544\uC8FC\uB124. \uB9DE\uC544, \uC6B0\uB9B0 \uD3C9\uC0DD \uC774 \uBD88\uAE38
    \uC18D\uC5D0\uC11C \uC11C\uB85C\uB9CC \uBCF4\uBA74\uC11C \uC9C0\uB0B4\uB294 \uAC70\uC57C.
    \uB108\uBB34 \uD589\uBCF5\uD574, \uC2DC\uC7A5\uB2D8\u2026\u2026 \""
  - "#(\uD30C\uAD6D\uC740 \uBA74\uD588\uC9C0\uB9CC, \uBC1C\uBAA9\uC744 \uC870\uC5EC\uC624\uB294
    \uCCA0\uC81C\uC758 \uC555\uBC15\uAC10\uACFC \uAE30\uACC4\uB4E4\uC758 \uC5F4\uAE30\uB294
    \uBC29\uC548\uC758 \uC0B0\uC18C\uB97C \uAC00\uC058\uAC8C \uB9CC\uB4E0\uB2E4.)"
