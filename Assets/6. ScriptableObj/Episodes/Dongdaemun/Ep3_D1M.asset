  m_Name: Ep3_D1M
  m_EditorClassIdentifier: 
  selectname: "\u201C\uC5B4\uB514 \uC0BC\uB958 \uBC94\uC8C4\uC790 \uB188\uB4E4\uC774
    \uC2DC\uC7A5\uC744 \uD611\uBC15\uD558\uB824 \uB4DC\uB098! \uB2F9\uC7A5 \uADF8
    \uCE7C \uB0B4\uB824\uB193\uC9C0 \uBABB\uD574!\u201D (\uB2E8\uD638\uD558\uACE0
    \uCC28\uAC00\uC6B4 \uBAA9\uC18C\uB9AC\uB85C \uD638\uD1B5\uCE58\uBA70 \uD611\uBC15\uBC94\uB4E4\uC5D0\uAC8C
    \uD0C0\uD611 \uC5C6\uB294 \uD0DC\uB3C4\uB85C \uC120\uC744 \uAE0B\uB294\uB2E4.) "
  th: 0
  iscorrect: 0
  selectedlog:
  - "#(\uB0B4 \uB0C9\uC815\uD55C \uD638\uD1B5\uACFC \uC5C4\uACA9\uD55C \uD0DC\uB3C4\uC5D0
    \uD611\uBC15\uBC94\uB4E4\uC774 \uC8FC\uCDA4\uAC70\uB9AC\uBA70 \uCE7C\uB0A0\uC744
    \uC2AC\uADF8\uBA38\uB2C8 \uB0B4\uB9B0\uB2E4.) "
  - "#(\uC0C1\uD669\uC740 \uC9C4\uC815\uB418\uC5C8\uC9C0\uB9CC, \uB0B4 \uB0C9\uC815\uD55C
    \uD0DC\uB3C4\uAC00 \uB3D9\uB300\uBB38\uAD6C\uC758 \uAC70\uB300\uD55C \uACB0\uD54D\uC744
    \uC815\uBA74\uC73C\uB85C \uCC14\uB800\uB2E4.) "
  - "\u201C\uC0BC\uB958\u2026\u2026? \uC544\uD558\uD558, \uC5ED\uC2DC \uADF8\uB807\uAD6C\uB098.
    \uCC98\uC74C\uC73C\uB85C \uB0B4 \uCD08\uB77C\uD55C \uBC14\uB2E5\uC744 \uB4E4\uCF30\uB294\uB370,
    \uC2DC\uC7A5\uB2D8 \uB208\uC5D4 \uB0B4\uAC00 \uADF8\uB0E5 \uC774 \uBC94\uC8C4\uC790
    \uB188\uB4E4\uC774\uB791 \uC5EE\uC778 \uC6B0\uC2A4\uC6B4 \uC0AC\uAE30\uAFBC\uC73C\uB85C
    \uBCF4\uC600\uB098 \uBCF4\uB124?\u201D"
  - "#(\uADF8\uB140\uB294 \uAE7B\uC78E\uBA38\uB9AC \uC0AC\uC774\uB85C \uB208\uBB3C
    \uBC94\uBC85\uC774 \uB41C \uC5BC\uAD74\uC744 \uB4DC\uB7EC\uB0B4\uBA70 \uB098\uB97C
    \uC2F8\uB298\uD558\uAC8C \uBE44\uC6C3\uB294\uB2E4.) "
