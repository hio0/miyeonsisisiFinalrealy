  th: 1
  iscorrect: 0
  selectedlog:
  - "#(\uB0B4 \uB0C9\uC815\uD55C \uAC70\uC808\uACFC \uC2E0\uACE0 \uC804\uD654 \uC18C\uB9AC\uC5D0,
    \uB3D9\uB300\uBB38\uAD6C\uC758 \uB208\uB3D9\uC790\uC5D0\uC11C \uC77C\uB9D0\uC758
