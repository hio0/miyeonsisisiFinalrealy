  - "#(\uADF8\uB140\uB294 \uB2E4\uAC00\uC624\uB294 \uCC28\uB7C9\uC758 \uAE09\uBE0C\uB808\uC774\uD06C
    \uC18C\uB9AC \uC18D\uC5D0\uC11C \uC816\uC740 \uBD84\uD64D\uC0C9 \uBA38\uB9AC\uCE7C\uC744
    \uB298\uC5B4\uB728\uB9B0 \uCC44, \uB098\uB97C \uD5A5\uD574 \uC18C\uB984 \uB07C\uCE58\uB3C4\uB85D
    \uCC28\uAC00\uC6B4 \uC800\uC8FC\uB97C \uB0B4\uBC49\uB294\uB2E4.) "
  - " \u201C\uACB0\uAD6D \uB0A8\uC758 \uC190\uC744 \uBE4C\uB824\uC11C \uB0A0 \uC815\uC2E0\uBCD1\uC790
    \uCDE8\uAE09\uD558\uB294\uAD6C\uB098. \uAE30\uC5B5\uD574 \uB46C, \uC2DC\uC7A5\uB2D8.
    \uB0B4\uAC00 \uC774 \uB3C4\uB85C \uC704\uC5D0\uC11C \uAC08\uB824 \uB098\uAC00
    \uC8FD\uB354\uB77C\uB3C4\u2026\u2026 \uB0B4 \uC720\uB839\uC774 \uD3C9\uC0DD \uB2F9\uC2E0
    \uB4F1 \uB4A4\uC5D0 \uBD99\uC5B4\uC11C \uC678\uB86D\uAC8C \uB9CC\uB4E4\uC5B4
    \uC904 \uD14C\uB2C8\uAE4C.\u201D "
