  m_Script: {fileID: 11500000, guid: d86ef726ec2bb1340be9fc0a470d9b84, type: 3}
  m_Name: DdEpisode1
  m_EditorClassIdentifier: 
  texts:
  - "`#(\uD3C9\uC18C\uC5D0 \"\uC800 \uC9C4\uC9DC \uC5C4\uCCAD \uB300\uB2E8\uD55C
    \uAC00\uBB38 \uCD9C\uC2E0\uC774\uAC70\uB4E0\uC694? \uB300\uD559\uB3C4 \uC7A5\uD559\uC0DD\uC73C\uB85C
    \uB2E4\uB2C8\uB2E4\uAC00 \uC9C0\uAE08 \uC7A0\uAE50 \uC26C\uB294 \uAC70\uACE0\uC694!\"\uB77C\uBA70
    \uC794\uB729 \uB0A0\uC744 \uC138\uC6B0\uB358 \uB3D9\uB300\uBB38\uAD6C\uB294,) "
  - "`#(\uB2A6\uC740 \uBC24 \uCCAD\uB7C9\uB9AC\uC5ED \uC55E \uAD50\uCC28\uB85C \uD55C\uBCF5\uD310\uC5D0\uC11C
    \uC794\uB729 \uCDE8\uD55C \uCC44 \uB098\uB97C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uB2E4.)"
  - "`#(\uAC00\uAE4C\uC774\uC11C \uBCF8 \uADF8\uB140\uC758 \uB208\uB3D9\uC790\uB294
    \uC678\uB85C\uC6C0\uACFC \uBD88\uC548\uC73C\uB85C \uCC98\uCC38\uD558\uAC8C \uD754\uB4E4\uB9AC\uACE0
    \uC788\uC5C8\uB2E4.)"
  - "[nomal]\u201C\uC5B4? \uC2DC\uC7A5\uB2D8\uC774\uB2E4\uC544! \uD5E4\uD5E4, \uC65C
    \uC774\uC81C \uC640\uC694? \uB098 \uBC84\uB9AC\uACE0 \uAC04 \uC904 \uC54C\uC558\uC796\uC544\u2026\u2026.
    \uC544, \uB9DE\uB2E4! \uB098 \uBC29\uAE08 \uC5C4\uCCAD \uB300\uB2E8\uD55C \uBE4C\uB529
    \uD22C\uC790\uC790 \uB9CC\uB098\uACE0 \uC624\uB294 \uAE38\uC774\uC5D0\uC694!
    \uC9C4\uC9DC\uB77C\uB2C8\uAE4C? \uB098 \uC778\uB9E5 \uC7A5\uB09C \uC544\uB2C8\uC5D0\uC694!\u201D "
  - "`#(\uC228 \uC26C\uB4EF \uC3DF\uC544\uB0B4\uB294 \uACFC\uC7A5\uACFC \uAC70\uC9D3\uB9D0.)"
  - "`#(\uC790\uC2E0\uC774 \uD3C9\uBC94\uD558\uACE0 \uBCFC\uD488\uC5C6\uB294 \uC874\uC7AC\uB77C\uB294
    \uAC78 \uB4E4\uD0A4\uBA74 \uB2F9\uC7A5\uC774\uB77C\uB3C4 \uBC84\uB824\uC9C8 \uAC83
    \uAC19\uB2E4\uB294 \uACF5\uD3EC\uAC00 \uADF8\uB140\uB97C \uC9D1\uC5B4\uC0BC\uCF1C
    \uD558\uB294 \uD589\uB3D9\uC774\uB2E4.) "
  - "`#(\uADF8\uB54C, \uBA40\uB9AC\uC11C \uB300\uD615 \uD654\uBB3C\uD2B8\uB7ED\uC774
    \uC694\uB780\uD55C \uACBD\uC801\uC744 \uC6B8\uB9AC\uBA70 \uAD50\uCC28\uB85C\uB85C
    \uB3CC\uC9C4\uD574 \uC624\uAE30 \uC2DC\uC791\uD588\uB2E4.)  "
  - "`#(\uB3D9\uB300\uBB38\uAD6C\uB294 \uB0B4 \uC2DC\uC120\uC744 \uBD99\uC7A1\uACE0
    \uC2F6\uB2E4\uB294 \uB4EF, \uC704\uD5D8\uCC9C\uB9CC\uD558\uAC8C\uB3C4 \uD2B8\uB7ED\uC774
    \uB2EC\uB824\uC624\uB294 \uCC28\uB3C4\uB85C \uAC11\uC790\uAE30 \uBC1C\uC744 \uB0B4\uB514\uB514\uBA70
    \uD654\uC0AC\uD558\uAC8C \uC6C3\uC5C8\uB2E4.)"
  - "`# (\uC7A0\uAE50 \uB2F9\uC2E0\uC774 \uC2DC\uC120\uC744 \uB3CC\uB838\uC744 \uB54C..) "
  - "[nomal]\u201C\uC2DC\uC7A5\uB2D8, \uB098 \uBD10\uBD10\uC694! \uB098 \uC9C4\uC9DC
    \uD2B9\uCD9C\uB098\uACE0 \uB300\uB2E8\uD55C \uC0AC\uB78C \uB9DE\uC8E0? \uADF8\uB7EC\uB2C8\uAE4C\u2026\u2026
    \uADF8\uB7EC\uB2C8\uAE4C \uC81C\uBC1C \uB208 \uB3CC\uB9AC\uC9C0 \uB9D0\uACE0
    \uB098\uB9CC \uBD10! \uC5EC\uAE30\uC11C \uB0B4\uAC00 \uCC28\uC5D0 \uCE58\uC5EC
    \uC8FD\uC5B4\uB3C4, \uB0B4 \uBCF8\uBAA8\uC2B5\uC774 \uD55C\uC2EC\uD558\uBA74
    \uADF8\uB0E5 \uBC84\uB9B4 \uAC70\uC796\uC544!!\u201D "
  - "*#(\uBBF8\uCE5C \uB4EF\uC774 \uCC28\uB3C4\uB85C \uB6F0\uC5B4\uB4DC\uB294 \uADF8\uB140\uB97C
    \uB9C9\uAE30 \uC704\uD574 \uB098\uB294 \uC5B4\uB5A4 \uD589\uB3D9\uC744 \uCDE8\uD574\uC57C
    \uD560\uAE4C?)"
  selects:
  - {fileID: 11400000, guid: fa109f7b801475143922951b6a6e9189, type: 2}
