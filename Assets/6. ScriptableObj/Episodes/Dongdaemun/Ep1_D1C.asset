  selectname: "(\uB9DD\uC124\uC784 \uC5C6\uC774 \uCC28\uB3C4\uB85C \uB6F0\uC5B4\uB4E4\uC5B4
    \uADF8\uB140\uC758 \uD654\uB824\uD55C \uC190\uBAA9\uC744 \uB09A\uC544\uCC44 \uC778\uB3C4
    \uC704\uB85C \uAC70\uCE60\uAC8C \uB04C\uC5B4\uB2F9\uACA8 \uC548\uC73C\uBA70)
    \u201C\uAC70\uC9D3\uB9D0\uC774\uB77C\uB3C4 \uC0C1\uAD00\uC5C6\uC73C\uB2C8\uAE4C
    \uB0B4 \uC55E\uC5D0\uC11C \uC0AC\uB77C\uC9C0\uC9C0 \uB9C8! \uB124\uAC00 \uC5B4\uB5A4
    \uBAA8\uC2B5\uC774\uB4E0 \uC548 \uBC84\uB824!\u201D "
  th: 0
  iscorrect: 1
  selectedlog:
  - "#(\uCFE0\uB974\uB989\uD558\uB294 \uAD49\uC74C\uACFC \uD568\uAED8 \uD2B8\uB7ED\uC774
    \uC544\uC2AC\uC544\uC2AC\uD558\uAC8C \uC2A4\uCCD0 \uC9C0\uB098\uAC04\uB2E4.)"
  - "#(\uB0B4 \uD488\uC5D0 \uC548\uAE34 \uB3D9\uB300\uBB38\uAD6C\uC758 \uC8FC\uB801\uC8FC\uB801\uD55C
    \uC561\uC138\uC11C\uB9AC\uB4E4\uC774 \uCC30\uB791\uC774\uBA70 \uBD80\uB52A\uD78C\uB2E4.)"
  - "#(\uADF8\uB140\uC758 \uD48D\uB9CC\uD55C \uAC00\uC2B4\uC774 \uB0B4 \uAC00\uC2B4\uD30D\uC5D0
    \uB2FF\uC740 \uCC44 \uBBF8\uCE5C \uB4EF\uC774 \uB6F0\uACE0 \uC788\uB2E4.) "
  - "\u201C\uC2DC\uC7A5\uB2D8\u2026\u2026? \uD558\uC544, \uC557\u2026\u2026 \uC9C4\uC9DC\uB85C?
    \uB098 \uC9C4\uC9DC \uBEE5\uC7C1\uC774\uC5D0, \uB300\uB2E8\uD55C \uAC70 \uD558\uB098\uB3C4
    \uC5C6\uB294 \uC0AC\uB78C\uC778\uB370 \uC815\uB9D0 \uC548 \uBC84\uB9B4 \uAC70\uC608\uC694\u2026\u2026?\u201D"
  - "#(\uC790\uC2E0\uC758 \uBAA9\uC228\uC744 \uAC78\uACE0 \uB3C5\uC810\uD558\uB824
    \uD588\uB358 \uC628\uAE30\uAC00 \uC804\uD574\uC9C0\uC790, \uD654\uB824\uD558\uAC8C
    \uBD80\uD480\uB838\uB358 \uAC00\uC2DC\uAC00 \uC21C\uC2DD\uAC04\uC5D0 \uB179\uC544\uB0B4\uB9B0\uB2E4.)"
  - "#(\uADF8\uB140\uB294 \uB0B4 \uC637\uC790\uB77D\uC744 \uAF49 \uC954 \uCC44 \uD551\uB69D
    \uBA38\uB9AC\uB97C \uB0B4 \uC5B4\uAE68\uC5D0 \uBB3B\uB294\uB2E4.) ##(\uADF8\uB9AC\uACE0
    \uC5B4\uB9B0\uC544\uC774\uCC98\uB7FC \uC194\uC9C1\uD55C \uB208\uBB3C\uC744 \uD758\uB9AC\uAE30
    \uC2DC\uC791\uD55C\uB2E4.) "
