  m_Script: {fileID: 11500000, guid: d86ef726ec2bb1340be9fc0a470d9b84, type: 3}
  m_Name: DdEpisode2
  m_EditorClassIdentifier: 
  texts:
  - "`#(\uB3D9\uB300\uBB38\uAD6C\uC640 \uB9CC\uB09C \uC9C0 \uC5B4\uB290\uB367 \uBA87
    \uC8FC\uAC00 \uD750\uB978 \uBE44 \uC624\uB294 \uB0A0 \uBC24.) "
  - "`#(\uCD08\uBC18\uC758 \uD130\uBB34\uB2C8\uC5C6\uB358 \uAC70\uC9D3\uB9D0\uB4E4\uC740
    \uC870\uAE08\uC529 \uC904\uC5B4\uB4E4\uACE0 \uB9CE\uC774 \uC815\uC9C1\uD574\uC84C\uC9C0\uB9CC,)  "
  - "`#(\uC5EC\uC804\uD788 \uBCF8\uBAA8\uC2B5\uC744 \uB4E4\uD0A4\uBA74 \uBC84\uB824\uC9C8\uC9C0
    \uBAA8\uB978\uB2E4\uB294 \uBD88\uC548\uAC10\uC5D0 \uC2DC\uB2EC\uB9AC\uB294 \uB3D9\uB300\uBB38\uAD6C\uC640
    \uCCAD\uB7C9\uB9AC\uC5ED \uC778\uADFC\uC758 \uAC00\uD30C\uB978 \uC8FC\uD0DD\uAC00\uB97C
    \uAC77\uACE0 \uC788\uC5C8\uB2E4.) "
  - "`#(\uD654\uB824\uD55C \uD551\uD06C\uC0C9 \uC0DD\uBA38\uB9AC \uCE7C\uB2E8\uBC1C\uC740
    \uBE57\uBB3C\uC5D0 \uC816\uC5B4 \uBEA8\uC5D0 \uB2EC\uB77C\uBD99\uC5B4 \uC788\uC5C8\uACE0,
    \uACFC\uC7A5\uB41C \uC561\uC138\uC11C\uB9AC\uB4E4\uC740 \uBE57\uC18C\uB9AC\uC5D0
    \uBB3B\uD600 \uC4F8\uC4F8\uD558\uAC8C \uCC30\uB791\uC600\uB2E4.) "
  - "`#(\uADF8\uB140\uB294 \uAE00\uB798\uBA38\uB7EC\uC2A4\uD55C \uBAB8\uB9E4\uB97C
    \uAC00\uB9AC\uB824\uB294 \uB4EF \uB0A1\uC740 \uACFC\uC7A0\uBC14\uB97C \uD479
    \uB20C\uB7EC\uC4F4 \uCC44, \uAE7B\uC78E\uBA38\uB9AC \uC0AC\uC774\uB85C \uB0B4
    \uB208\uCE58\uB97C \uC0B4\uD53C\uBA70 \uACA8\uC6B0 \uC785\uC744 \uC5F4\uC5C8\uB2E4.)"
  - "[shy]\u201C\uC2DC\uC7A5\uB2D8\u2026\u2026 \uC0AC\uC2E4 \uB098, \uC7A5\uD559\uC0DD
    \uAC19\uC740 \uAC70 \uC544\uB2C8\uC5D0\uC694. \uC9D1\uB3C4 \uC5C4\uCCAD \uAC00\uB09C\uD558\uACE0,
    \uADF8\uB0E5 \uAE30\uC8FD\uAE30 \uC2EB\uC5B4\uC11C \uB9E8\uB0A0 \uB300\uB2E8\uD55C
    \uCC99 \uBEE5\uCE5C \uAC70\uC608\uC694. \uBBF8\uC548\uD574\uC694\u2026\u2026.
    \uC774\uC81C \uB098 \uAC19\uC774 \uD55C\uC2EC\uD55C \uC560\uB294\u2026\u2026
    \uBCF4\uAE30 \uC2EB\uC8E0?\u201D "
  - "`#(\uB4DC\uB514\uC5B4 \uC790\uC2E0\uC758 \uCD08\uB77C\uD55C \uD604\uC2E4\uC744
    \uC194\uC9C1\uD558\uAC8C \uACE0\uBC31\uD55C \uB3D9\uB300\uBB38\uAD6C.) "
  - "`#(\uB3D9\uB300\uBB38\uAD6C\uB294 \uB0B4 \uC2DC\uC120\uC744 \uBD99\uC7A1\uACE0
    \uC2F6\uB2E4\uB294 \uB4EF, \uC704\uD5D8\uCC9C\uB9CC\uD558\uAC8C\uB3C4 \uD2B8\uB7ED\uC774
    \uB2EC\uB824\uC624\uB294 \uCC28\uB3C4\uB85C \uAC11\uC790\uAE30 \uBC1C\uC744 \uB0B4\uB514\uB514\uBA70
    \uD654\uC0AC\uD558\uAC8C \uC6C3\uC5C8\uB2E4.)"
  - "`#(\uADF8\uB54C, \uAC00\uD30C\uB978 \uBE57\uAE38 \uC5B8\uB355 \uC704\uC5D0\uC11C
    \uC8FC\uCC28 \uBE0C\uB808\uC774\uD06C\uAC00 \uD480\uB9B0 \uBB34\uAC70\uC6B4 \uB9AC\uC5B4\uCE74
    \uD55C \uB300\uAC00 \uC5C4\uCCAD\uB09C \uC18D\uB3C4\uB85C \uADF8\uB140\uB97C
    \uD5A5\uD574 \uBBF8\uB044\uB7EC\uC838 \uB0B4\uB824\uC624\uAE30 \uC2DC\uC791\uD588\uB2E4.) "
  - "`#(\uB3D9\uB300\uBB38\uAD6C\uB294 \uD53C\uD574\uAC08 \uC218 \uC788\uB294 \uAC70\uB9AC\uC784\uC5D0\uB3C4
    \uBD88\uAD6C\uD558\uACE0, \uB0B4 \uB9C8\uC74C\uC744 \uD655\uC778\uD558\uB824\uB294
    \uB4EF \uC704\uD5D8\uCC9C\uB9CC\uD558\uAC8C \uADF8 \uC790\uB9AC\uC5D0 \uC5BC\uC5B4\uBD99\uC740
    \uCC44 \uB208\uBB3C\uC744 \uD758\uB9AC\uBA70 \uB098\uB97C \uBC14\uB77C\uBCF4\uC558\uB2E4.) "
  - "[angry]\u201C\uB098 \uC9C4\uC9DC \uB300\uB2E8\uD55C \uAC70 \uD558\uB098\uB3C4
    \uC5C6\uB2E8 \uB9D0\uC774\uC5D0\uC694! \uADF8\uB7EC\uB2C8\uAE4C\u2026\u2026 \uC5EC\uAE30\uC11C
    \uB0B4\uAC00 \uB2E4\uCE58\uAC70\uB098 \uC0AC\uB77C\uC838\uB3C4 \uC2DC\uC7A5\uB2D8\uC740
    \uB208 \uD558\uB098 \uAE5C\uC9DD \uC548 \uD558\uACA0\uC8E0?\""
  - "[angry]\"\uB0A0 \uC9C4\uC9DC\uB85C \uC544\uB07C\uB294 \uAC74\uC9C0, \uC544\uB2C8\uBA74
    \uBD88\uC30D\uD574\uC11C \uB9CC\uB098\uC900 \uAC74\uC9C0 \uB611\uBC14\uB85C \uB9D0\uD574\uC918\uC694!!\u201D "
  - "`#(\uBE57\uAE38 \uC18D\uC5D0\uC11C \uAD74\uB7EC\uB5A8\uC5B4\uC9C0\uB294 \uB9AC\uC5B4\uCE74\uB97C
    \uB9C8\uC8FC\uD55C \uCC44 \uB098\uB97C \uC2DC\uD5D8\uD558\uB824\uB294 \uC704\uD0DC\uB85C\uC6B4
    \uC0C1\uD669.) "
  - "*#(\uC815\uC9C1\uD574\uC9C4 \uADF8\uB140\uC758 \uC0C1\uCC98\uB97C \uB9C8\uC8FC\uD55C
    \uB098\uB294 \uCCAB \uBC88\uC9F8 \uD589\uB3D9\uC744 \uCDE8\uD574\uC57C \uD55C\uB2E4.)"
  - "`#(\uAC10\uC815\uC774 \uADF9\uC5D0 \uB2EC\uD55C \uB3D9\uB300\uBB38\uAD6C\uB294
    \uCCAD\uB7C9\uB9AC\uC5ED \uC55E\uC758 \uAC70\uB300\uD55C \uC655\uBCF5 8\uCC28\uC120
    \uB300\uB85C\uBCC0 \uAD50\uCC28\uB85C\uAE4C\uC9C0 \uC2E4\uC2DC\uAC04\uC73C\uB85C
    \uB2EC\uB824 \uB098\uAC14\uB2E4.) "
  - "`#(\uD3ED\uC6B0 \uC18D\uC5D0\uC11C \uC218\uB9CE\uC740 \uC790\uB3D9\uCC28\uAC00
    \uC804\uC870\uB4F1\uC744 \uCF1C\uACE0 \uBE60\uB978 \uC18D\uB3C4\uB85C \uC9C8\uC8FC\uD558\uB294
    \uC704\uD5D8\uD55C \uB3C4\uB85C \uD658\uACBD.) "
  - "`#(\uADF8\uB140\uB294 \uC2E0\uD638\uB4F1\uC774 \uBE68\uAC04\uBD88\uC784\uC5D0\uB3C4
    \uBD88\uAD6C\uD558\uACE0, \uD551\uB69D \uC0DD\uBA38\uB9AC\uB97C \uAC70\uCE60\uAC8C
    \uD718\uB0A0\uB9AC\uBA70 \uBE57\uBB3C\uC774 \uACE0\uC778 \uCC28\uB3C4 \uD55C\uBCF5\uD310\uC73C\uB85C
    \uC131\uD07C\uC131\uD07C \uAC78\uC5B4 \uB4E4\uC5B4\uAC00 \uB3CC\uC544\uC120\uB2E4.) "
  - "`#(\uBC18\uC9C0\uC640 \uADC0\uAC78\uC774\uAC00 \uBE57\uBB3C\uC5D0 \uBC18\uC0AC\uB418\uC5B4
    \uCC98\uC5F0\uD558\uAC8C \uBC18\uC9DD\uC774\uB294 \uAC00\uC6B4\uB370, \uADF8\uB140\uB294
    \uB2E4\uAC00\uC624\uB294 \uB300\uD615 \uBC84\uC2A4\uC758 \uD5E4\uB4DC\uB77C\uC774\uD2B8\uB97C
    \uC815\uBA74\uC73C\uB85C \uB9C8\uC8FC\uD558\uBA70 \uB098\uB97C \uD5A5\uD574 \uD45C\uB3C5\uC2A4\uB7FD\uACE0\uB3C4
    \uC2AC\uD504\uAC8C \uC18C\uB9AC\uCCE4\uB2E4.) "
  - "[menhera]\u201C\uC194\uC9C1\uD574\uC9C0\uBA74 \uACC1\uC5D0 \uC788\uC5B4 \uC900\uB2E4\uBA70!
    \uADFC\uB370 \uC65C \uB0B4 \uB9C8\uC74C\uC740 \uC5EC\uC804\uD788 \uC774\uB807\uAC8C
    \uC678\uB86D\uACE0 \uD130\uC9C8 \uAC83 \uAC19\uC740 \uAC74\uB370?! \uC2DC\uC7A5\uB2D8\uC774
    \uB098\uD55C\uD14C \uD655\uC2E0\uC744 \uC8FC\uC9C0 \uC54A\uC73C\uBA74, \""
  - "\"\uB098 \uC9C4\uC9DC \uC5EC\uAE30\uC11C \uCF71 \uCE58\uC5EC\uC11C \uD754\uC801\uB3C4
    \uC5C6\uC774 \uC0AC\uB77C\uC838 \uBC84\uB9B4 \uAC70\uC57C!!\u201D "
  - "*#(\uAD50\uCC28\uB85C \uD55C\uBCF5\uD310, \uAD50\uD1B5\uC0AC\uACE0\uC758 \uC704\uD5D8
    \uC18D\uC73C\uB85C \uC2A4\uC2A4\uB85C\uB97C \uB358\uC9C0\uBA70 \uB9C8\uC9C0\uB9C9
    \uB3C5\uC810\uC695\uC744 \uD3ED\uBC1C\uC2DC\uD0A4\uB294 \uADF8\uB140\uB97C \uBCF4\uBA70
    \uB450 \uBC88\uC9F8 \uCD5C\uC885 \uC120\uD0DD\uC744 \uB0B4\uB824\uC57C \uD55C\uB2E4.) "
  selects:
  - {fileID: 11400000, guid: c24a8fdd7ce60d145bb4ba1d6e1e62b2, type: 2}
  - {fileID: 11400000, guid: 57558ba01ffb1994ab3626ed28a92818, type: 2}
