  m_Name: Ep3_D1C
  m_EditorClassIdentifier: 
  selectname: "(\uB9DD\uC124\uC784 \uC5C6\uC774 \uC55E\uC73C\uB85C \uAC78\uC5B4\uAC00
    \uD611\uBC15\uBC94\uC758 \uCE7C\uB0A0\uC744 \uB0B4 \uC190\uBC14\uB2E5\uC73C\uB85C
    \uAC70\uCE60\uAC8C \uC950\uC5B4 \uAC00\uB85C\uB9C9\uACE0, \uB2E4\uB978 \uC190\uC73C\uB85C
    \uB3D9\uB300\uBB38\uAD6C\uB97C \uB0B4 \uD488 \uC548\uC73C\uB85C \uAC70\uCE60\uAC8C
    \uB2F9\uACA8 \uC548\uC73C\uBA70) \u201C\uADF8 \uCE7C \uCE58\uC6CC. \uB3C8\uC774\uB4E0
    \uC7A5\uBD80\uB4E0 \uB2E4 \uC904 \uD14C\uB2C8\uAE4C \uB0B4 \uC5EC\uC790 \uBAB8\uC5D0
    \uC190\uB300\uC9C0 \uB9C8!\u201D"
  th: 0
  iscorrect: 1
  selectedlog:
  - "#(\uB0B4 \uC190\uBC14\uB2E5\uC5D0\uC11C \uBD89\uC740 \uD53C\uAC00 \uBD84\uC218\uCC98\uB7FC
    \uC3DF\uC544\uC9C0\uC790 \uD611\uBC15\uBC94\uB4E4\uC774 \uB2F9\uD669\uD574 \uB4A4\uB85C
    \uBB3C\uB7EC\uC120\uB2E4.) "
  - "#(\uB0B4 \uD488\uC5D0 \uC548\uAE34 \uB3D9\uB300\uBB38\uAD6C\uC758 \uC8FC\uB801\uC8FC\uB801\uD55C
    \uBC18\uC9C0\uC640 \uC561\uC138\uC11C\uB9AC\uB4E4\uC774 \uC0AC\uC815\uC5C6\uC774
    \uD754\uB4E4\uB9B0\uB2E4.) "
  - "#(\uADF8\uB140\uC758 \uD48D\uB9CC\uD55C \uAC00\uC2B4\uC774 \uB0B4 \uAC00\uC2B4\uD30D\uC5D0
    \uB2FF\uC740 \uCC44 \uACF5\uD3EC\uC640 \uACBD\uC545\uC73C\uB85C \uBBF8\uCE5C
    \uB4EF\uC774 \uB6F0\uACE0 \uC788\uB2E4.) "
  - "\u201C\uC2DC\uC7A5\uB2D8\u2026\u2026? \uC190\uC5D0\uC11C \uD53C\uAC00\u2026\u2026
    \uC65C \uB098 \uAC19\uC740 \uAC00\uC9DC \uB54C\uBB38\uC5D0 \uBAA9\uC228\uC744
    \uAC78\uC5B4\uC694\u2026\u2026? \uB098 \uC7A5\uD559\uC0DD\uB3C4 \uC544\uB2C8\uACE0
    \uC9C4\uC9DC \uC544\uBB34\uAC83\uB3C4 \uC5C6\uB294 \uD55C\uC2EC\uD55C \uB144\uC778\uB370\u2026\u2026
    \uC815\uB9D0 \uB098 \uC548 \uBC84\uB9B4 \uAC70\uC608\uC694\u2026\u2026?\u201D "
  - "#(\uC790\uC2E0\uC758 \uBAA9\uC228\uACFC \uD604\uC2E4\uC744 \uC194\uC9C1\uD558\uAC8C
    \uD138\uC5B4\uB193\uC73C\uBA70, \uB0B4 \uD53C\uC640 \uC628\uAE30 \uC18D\uC5D0\uC11C
    \uD654\uB824\uD558\uAC8C \uBD80\uD480\uB838\uB358 \uAC00\uC2DC\uB97C \uC644\uC804\uD788
    \uB0B4\uB824\uB193\uACE0 \uC5B4\uB9B0\uC544\uC774\uCC98\uB7FC \uB0B4 \uD488\uC5D0
    \uC548\uACA8 \uD750\uB290\uB080\uB2E4.) "
