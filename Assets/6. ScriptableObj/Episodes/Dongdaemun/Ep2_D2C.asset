  selectname: "(\uB2EC\uB824\uC624\uB294 \uBC84\uC2A4\uB97C \uB4F1\uC9C0\uACE0 \uCC28\uB3C4\uB85C
    \uB6F0\uC5B4\uB4E4\uC5B4 \uADF8\uB140\uC758 \uD5C8\uB9AC\uB97C \uAC15\uD558\uAC8C
    \uAEF4\uC548\uC544 \uC778\uB3C4 \uC704\uB85C \uAD74\uB7EC\uB5A8\uC5B4\uC9C0\uBA70)
    \u201C\uB0B4 \uBAA9\uC228\uC744 \uAC78\uACE0 \uC57D\uC18D\uD560\uAC8C! \uB0B4
    \uB208\uC5D4 \uB108\uBC16\uC5D0 \uC548 \uBCF4\uC5EC, \uADF8\uB7EC\uB2C8\uAE4C
    \uC81C\uBC1C \uC774\uB7EC\uC9C0 \uB9C8!\u201D"
  th: 1
  iscorrect: 1
  selectedlog:
  - "#(\uAD49\uC74C\uACFC \uD568\uAED8 \uBC84\uC2A4\uAC00 \uAE09\uC815\uAC70\uD558\uBA70
