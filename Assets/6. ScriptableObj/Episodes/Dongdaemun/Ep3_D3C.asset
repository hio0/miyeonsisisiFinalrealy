  selectname: "(\uC815\uC2E0\uC744 \uBC14\uC9DD \uCC28\uB9AC\uACE0 \uB0B4 \uC8FC\uBA38\uB2C8\uC5D0
    \uC788\uB358 \uC791\uC740 \uB9E5\uB3C4\uB0A0\uB4DC \uC7A5\uB09C\uAC10 \uB098\uC774\uD504
    \uD301\uC744 \uC218\uAC11\uC758 \uACE0\uC7A5 \uB09C \uD1B1\uB2C8 \uD2C8\uC0C8\uC5D0
    \uC464\uC154 \uB123\uC5B4 \uAE30\uC801\uC801\uC73C\uB85C \uB77D\uC744 \uD574\uC81C\uD55C
    \uB4A4, \uADF8\uB140\uB97C \uD1B5\uC9F8\uB85C \uB4E4\uCCD0\uC5C5\uACE0 \uBD88\uD0C0\uB294
    \uBCF4\uC77C\uB7EC\uC2E4 \uBB38\uC744 \uBAB8\uC73C\uB85C \uBD80\uC218\uBA70 \uD0C8\uCD9C\uD55C\uB2E4.)"
  th: 2
  iscorrect: 1
  selectedlog:
  - "#(\uC9C0\uD558\uB3C4\uB97C \uBE60\uC838\uB098\uC624\uC790\uB9C8\uC790 \uB4A4\uD3B8\uC5D0\uC11C
