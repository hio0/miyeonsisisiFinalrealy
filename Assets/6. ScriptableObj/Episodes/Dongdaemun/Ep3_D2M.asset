  m_EditorClassIdentifier: 
  selectname: "\u201C\uBBF8\uCE5C \uC9D3\uC740 \uADF8\uB9CC\uB46C, \uB3D9\uB300\uBB38\uAD6C!
    \uB2F9\uC7A5 \uC774 \uBD88 \uB044\uACE0 \uC0AC\uC2AC \uD480\uC9C0 \uBABB\uD574!
    \uB10C \uC9C0\uAE08 \uC644\uC804\uD788 \uC120\uC744 \uB118\uC5C8\uC5B4!\u201D(\uCCA0\uC0AC\uC2AC\uC744
    \uBC1C\uB85C \uAC70\uCE60\uAC8C \uCC28\uB0B4\uBA70 \uADF8\uB140\uB97C \uB728\uAC70\uC6B4
    \uD30C\uC774\uD504 \uBCBD \uCABD\uC73C\uB85C \uBC00\uCCD0\uB0B4\uB824 \uD55C\uB2E4.) "
  th: 1
  iscorrect: 0
  selectedlog:
  - "#(\uADF8\uB140\uB97C \uC81C\uC555\uD558\uAE30 \uC704\uD574 \uAC15\uC555\uC801\uC73C\uB85C
    \uBC1C\uC744 \uAD74\uB800\uC9C0\uB9CC, \uADF8\uAC83\uC774 \uADF8\uB140\uC758
    \uC5B5\uB20C\uB9B0 \uBC18\uBC1C\uC2EC\uC744 \uCD09\uBC1C\uD588\uB2E4.) "
  - "\u201C\uC120\u2026\u2026? \uC120\uC774\uB77C\uACE0 \uD588\uC5B4?! \uC5B8\uC81C\uB098
    \uC2DC\uC7A5\uB2D8\uC740 \uC800 \uBA40\uB9AC \uC120\uC744 \uADF8\uC5B4\uB450\uACE0
    \uB098\uB97C \uBC00\uC5B4\uB0B4\uAE30\uB9CC \uD588\uC73C\uBA74\uC11C!!\u201D "
  - "#(\uADF8\uB140\uB294 \uC5F0\uACB0\uB41C \uC0AC\uC2AC\uC744 \uC628 \uD798\uC744
    \uB2E4\uD574 \uC81C \uCABD\uC73C\uB85C \uC7A1\uC544\uB2F9\uACA8 \uB098\uB97C
    \uAC00\uC5F4\uB41C \uD30C\uC774\uD504 \uCABD\uC73C\uB85C \uB04C\uC5B4\uB2F9\uAE34\uB2E4.) "
  - "#(\uCCA0\uC81C \uC871\uC1C4\uAC00 \uC0B4\uC744 \uD30C\uACE0\uB4E4\uBA70 \uB0A0\uCE74\uB85C\uC6B4
    \uD1B5\uC99D\uC774 \uBC00\uB824\uC624\uACE0, \uADF8\uB140\uC758 \uC2AC\uD508
    \uB208\uBB3C\uC774 \uB0B4 \uBC1C\uB4F1 \uC704\uB85C \uCC28\uAC11\uAC8C \uD758\uB7EC\uB0B4\uB9B0\uB2E4.) "
