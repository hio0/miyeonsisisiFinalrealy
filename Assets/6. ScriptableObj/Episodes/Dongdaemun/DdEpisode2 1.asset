  m_Script: {fileID: 11500000, guid: d86ef726ec2bb1340be9fc0a470d9b84, type: 3}
  m_Name: DdEpisode2 1
  m_EditorClassIdentifier: 
  texts:
  - "`#(\uB3D9\uB300\uBB38\uAD6C\uC640 \uB9CC\uB09C \uC9C0 \uD55C \uB2EC\uC9F8 \uB418\uB358
    \uB0A0 \uBC24, \uCCAD\uB7C9\uB9AC\uC5ED \uC778\uADFC\uC758 \uC73C\uC2A5\uD55C
    \uB178\uC810\uC0C1 \uACE8\uBAA9 \uB4A4\uD3B8.) "
  - "`#(\uADF8\uB3D9\uC548 \uB3D9\uB300\uBB38\uAD6C\uAC00 \uAC00\uC9DC\uB85C \uBD80\uD480\uB824
    \uC628 \uD654\uB824\uD55C \uC778\uB9E5\uACFC \uAC00\uBB38\uC758 \uC2E4\uCCB4\uB97C
    \uB208\uCE58\uCC48 \uC9C8 \uB098\uC05C \uC0AC\uCC44\uC5C5\uC790 \uACB8 \uD611\uBC15\uBC94
    \uBB34\uB9AC\uAC00 \uADF8\uB140\uB97C \uB9C9\uB2E4\uB978 \uACE8\uBAA9\uC73C\uB85C
    \uBAB0\uC544\uB123\uACE0 \uC788\uC5C8\uB2E4.) "
  - "`#(\uD611\uBC15\uBC94\uB4E4\uC740 \"\uC7A5\uD559\uC0DD\uC5D0 \uBE4C\uB529 \uD22C\uC790\uC790\uB77C\uB354\uB2C8
    \uC21C \uAC70\uC9D3\uB9D0\uC7C1\uC774 \uB144\uC774\uC5C8\uC796\uC544? \uB3C8
    \uC548 \uAC1A\uC73C\uBA74 \uB124\uAC00 \uC2DC\uC7A5 \uAF2C\uC154\uC11C \uBE7C\uB3CC\uB9B0
    \uC7A5\uBD80 \uB2E4 \uD130\uD2B8\uB9B0\uB2E4?\"\uB77C\uBA70 \uADF8\uB140\uB97C
    \uAC70\uCE60\uAC8C \uBC00\uCCE4\uB2E4.)"
  - "[sad]\u201C\uD558, \uD558\uC544\u2026\u2026 \uADF8\uAC70 \uB2E4 \uC9C4\uC9DC\uB780
    \uB9D0\uC774\uC57C! \uB098 \uC9C4\uC9DC \uB300\uB2E8\uD55C \uC0AC\uB78C \uB9DE\uB2E4\uACE0!
    \uC2DC\uC7A5\uB2D8, \uB098 \uBD10\uBD10\uC694! \uB098 \uBEE5\uC7C1\uC774 \uC544\uB2C8\uC57C\u2026\u2026
    \uC81C\uBC1C \uC774 \uC778\uAC04\uB4E4 \uB9D0 \uB4E3\uC9C0 \uB9C8\uC694\u2026\u2026.\u201D "
  - "`#(\uACF5\uD3EC\uC5D0 \uC9C8\uB824 \uBC14\uB4E4\uBC14\uB4E4 \uB5A8\uBA74\uC11C\uB3C4,
    \uB0B4 \uC55E\uC5D0\uC11C \uAC00\uC9DC \uAECD\uB370\uAE30\uAC00 \uBC97\uACA8\uC9C0\uB294
    \uC218\uCE58\uC2EC\uC744 \uACAC\uB514\uC9C0 \uBABB\uD574 \uB05D\uAE4C\uC9C0 \uD5C8\uC138\uB97C
    \uBD80\uB9AC\uBA70 \uB208\uBB3C\uC744 \uD758\uB9AC\uB294 \uB3D9\uB300\uBB38\uAD6C.) "
  - "`#(\uADF8\uB54C \uBD84\uB178\uD55C \uD611\uBC15\uBC94 \uB450\uBAA9\uC774 \uC8FC\uBA38\uB2C8\uC5D0\uC11C
    \uB0A0\uCE74\uB85C\uC6B4 \uC7AD\uB098\uC774\uD504\uB97C \uAEBC\uB0B4 \uB4E4\uACE0
    \uB3D9\uB300\uBB38\uAD6C\uC758 \uD558\uC580 \uBAA9\uB35C\uBBF8\uC5D0 \uB4E4\uC774\uB300\uBA70
    \uB098\uB97C \uD611\uBC15\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4.)"
  - "`#(\uB0A0\uCE74\uB85C\uC6B4 \uCE7C\uB0A0\uC774 \uADF8\uB140\uC758 \uBD80\uB4DC\uB7EC\uC6B4
    \uC0B4\uACB0\uC744 \uD30C\uACE0\uB4E4\uBA70 \uD54F\uBC29\uC6B8\uC774 \uB9FA\uD788\uB294
    \uC77C\uCD09\uC989\uBC1C\uC758 \uC704\uAE30 \uC0C1\uD669.) "
  - "*#(\uADF8\uB140\uC758 \uC228\uD1B5\uC744 \uC950\uACE0 \uD754\uB4DC\uB294 \uD611\uBC15\uBC94\uB4E4
    \uC55E\uC5D0\uC11C \uB098\uB294 \uCCAB \uBC88\uC9F8 \uD589\uB3D9\uC744 \uCDE8\uD574\uC57C
    \uD55C\uB2E4.) "
  - "`#(\uD611\uBC15\uBC94\uB4E4\uC744 \uCAD3\uC544\uB0B8 \uC9C1\uD6C4, \uC644\uC804\uD788
    \uC774\uC131\uC744 \uC783\uC740 \uB3D9\uB300\uBB38\uAD6C\uB294 \uB0B4 \uC190\uBAA9\uC744
    \uB09A\uC544\uCC44 \uADFC\uCC98 \uBB34\uD5C8\uAC00 \uAC74\uBB3C \uC9C0\uD558\uC758
    \uC5B4\uB450\uC6B4 \uBCF4\uC77C\uB7EC\uC2E4 \uC548\uC73C\uB85C \uB098\uB97C \uB04C\uACE0
    \uB4E4\uC5B4\uAC14\uB2E4.) "
  - "`#(\uAE30\uACC4\uB4E4\uC774 \uC694\uB780\uD558\uAC8C \uB3CC\uC544\uAC00\uB294
    \uAC00\uC5F4\uB41C \uACF5\uAC04, \uADF8\uB140\uB294 \uBB38\uC744 \uC7A0\uADF8\uB354\uB2C8
    \uBCF4\uC77C\uB7EC \uD30C\uC774\uD504\uC5D0 \uC5F0\uACB0\uB41C \uD22C\uBC15\uD55C
    \uCCA0\uC81C \uC0AC\uC2AC\uC744 \uAEBC\uB0B4 \uB0B4 \uBC1C\uBAA9\uACFC \uC790\uC2E0\uC758
    \uBC1C\uBAA9\uC744 \uD558\uB098\uB85C \uBB36\uC5B4\uBC84\uB838\uB2E4.) "
  - "`#(\uADF8\uB9AC\uACE0 \uC8FC\uBA38\uB2C8\uC5D0\uC11C \uB77C\uC774\uD130\uB97C
    \uAEBC\uB0B4 \uBCF4\uC77C\uB7EC \uC81C\uC5B4 \uC7A5\uCE58\uC758 \uC804\uC120
    \uB354\uBBF8\uC5D0 \uBD88\uC744 \uBD99\uC5EC\uBC84\uB9B0 \uB4A4, \uBD84\uD64D\uC0C9
    \uB2E8\uBC1C\uBA38\uB9AC\uB97C \uB298\uC5B4\uB728\uB9AC\uBA70 \uD45C\uB3C5\uC2A4\uB7EC\uC6B4
    \uBBF8\uC18C\uB97C \uC9C0\uC5C8\uB2E4.) "
  - "[menhera[\u201C\uC2DC\uC7A5\uB2D8, \uC774\uC81C \uC774 \uC0AC\uC2AC\uC740 \uBCF4\uC77C\uB7EC\uAC00
    \uD3ED\uBC1C\uD558\uAE30 \uC804\uAE4C\uC9C4 \uC808\uB300 \uC548 \uD480\uB824\uC694.\u201D "
  - "[angry] \u201C\uB098\uAC00\uBD24\uC790 \uC2DC\uC7A5\uB2D8\uC740 \uB610 \uB098\uB97C
    \uC0BC\uB958 \uC0AC\uAE30\uAFBC \uCDE8\uAE09\uD558\uBA70 \uB2E4\uB978 \uD654\uB824\uD55C
    \uAD6C(\u5340)\uB4E4\uC744 \uBCF4\uB7EC \uB3C4\uB9DD\uCE60 \uAC70\uC796\uC544.\u201D "
  - "[menhera]\u201C\uADF8\uB7EC\uB2C8\uAE4C \uC6B0\uB9AC \uADF8\uB0E5 \uC5EC\uAE30\uC11C
    \uAC19\uC774 \uD0C0 \uC8FD\uB294 \uAC70\uC57C. \uB098\uB9CC \uAC00\uC9C8 \uC218
    \uC788\uAC8C.\u201D"
  - "`#(\uBC84\uB824\uC9C8\uC9C0\uB3C4 \uBAA8\uB978\uB2E4\uB294 \uADF9\uB2E8\uC801\uC778
    \uACF5\uD3EC\uAC00 \uADF8\uB140\uC758 \uC18C\uC720\uC695\uC744 \uCD5C\uC545\uC758
    \uBC29\uD5A5\uC73C\uB85C \uB4A4\uD2C0\uC5B4\uBC84\uB838\uB2E4.) "
  - "*#(\uC0AC\uC2AC\uC5D0 \uBB36\uC778 \uCC44 \uD0C0\uC624\uB974\uB294 \uBD88\uAE38\uC744
    \uB4F1\uC9C0\uACE0 \uB098\uB97C \uB0B4\uB824\uB2E4\uBCF4\uB294 \uADF8\uB140\uC5D0\uAC8C
    \uB450 \uBC88\uC9F8 \uB300\uB2F5\uC744 \uD574\uC57C \uD55C\uB2E4.) "
  - "`#(\uADF8 \uC21C\uAC04, \uACFC\uC5F4\uB41C \uBCF4\uC77C\uB7EC \uB0B4\uBD80\uC758
    \uC555\uB825\uC774 \uD55C\uACC4\uB97C \uCD08\uACFC\uD558\uBA70 \uC9C0\uC9C0\uC9C1\uAC70\uB9AC\uB294
    \uAD49\uC74C\uACFC \uD568\uAED8 \uBC38\uBE0C\uAC00 \uD130\uC838 \uB098\uAC00\uACE0,
    \uB728\uAC70\uC6B4 \uACE0\uC555\uC758 \uACE0\uC628 \uC99D\uAE30\uAC00 \uBC29\uC548
    \uAC00\uB4DD \uC0B4\uBC8C\uD558\uAC8C \uBFDC\uC5B4\uC838 \uB098\uC624\uAE30 \uC2DC\uC791\uD588\uB2E4.) "
  - "`#(\uC124\uC0C1\uAC00\uC0C1\uC73C\uB85C \uC81C\uC5B4 \uC7A5\uCE58\uAC00 \uC644\uC804\uD788
    \uD0C0\uB4E4\uC5B4\uAC00\uBA70 1\uBD84 \uB4A4\uC5D0 \uBCF4\uC77C\uB7EC \uBCF8\uCCB4\uAC00
    \uD1B5\uC9F8\uB85C \uD3ED\uBC1C\uD560 \uC704\uD5D8\uC5D0 \uCC98\uD55C \uC77C\uCD09\uC989\uBC1C\uC758
    \uC0C1\uD669.) "
  - "`#(\uB3D9\uB300\uBB38\uAD6C\uB294 \uB3C4\uB9DD\uCE58\uB824 \uD558\uAE30\uBCF4\uB2E4,
    \uC624\uD788\uB824 \uC99D\uAE30\uAC00 \uBFDC\uC5B4\uC838 \uB098\uC624\uB294 \uD30C\uC774\uD504
    \uC55E\uC73C\uB85C \uB0B4 \uBAB8\uC744 \uC774\uB04C\uBA70 \uC794\uD639\uD558\uACE0\uB3C4
    \uC2AC\uD504\uAC8C \uC18C\uB9AC\uCCE4\uB2E4.) "
  - "[menhera]\u201C\uCC28\uB77C\uB9AC \uC798\uB410\uC5B4! \uC774 \uBCF4\uC77C\uB7EC\uAC00
    \uD130\uC838\uC11C \uC6B0\uB9AC \uBAB8\uC774 \uD615\uCCB4\uB3C4 \uC5C6\uC774
    \uCC22\uACA8 \uB098\uAC00\uB354\uB77C\uB3C4, \uC2DC\uC7A5\uB2D8\uC740 \uD3C9\uC0DD
    \uB0B4 \uACC1\uC744 \uBABB \uB5A0\uB0A0 \uD14C\uB2C8\uAE4C!\u201D "
  - "[menhera]\u201C \uCC28\uB77C\uB9AC \uC5EC\uAE30\uC11C \uAC19\uC774 \uCC22\uACA8
    \uC8FD\uC744\uB798, \uC544\uB2C8\uBA74 \uB0A0 \uC9C4\uC9DC\uB85C \uC0AC\uB791\uD55C\uB2E4\uACE0
    \uB9F9\uC138\uD558\uACE0 \uAC19\uC774 \uB098\uAC08\uB798?! \uC120\uD0DD\uD574,
    \uC2DC\uC7A5\uB2D8!!\u201D "
  - "*#(\uACE0\uC628\uC758 \uC99D\uAE30\uAC00 \uC2DC\uC57C\uB97C \uAC00\uB9AC\uACE0
    \uC758\uC2DD\uC774 \uD63C\uBBF8\uD574\uC9C0\uB294 \uCC30\uB098, \uB3D9\uADC0\uC5B4\uC9C4\uC744
    \uC120\uD0DD\uD558\uB824\uB294 \uADF8\uB140\uB97C \uC800\uC9C0\uD558\uAE30 \uC704\uD55C
    \uC138 \uBC88\uC9F8 \uCD5C\uC885 \uC120\uD0DD\uC744 \uB0B4\uB824\uC57C \uD55C\uB2E4.) "
  selects:
  - {fileID: 11400000, guid: f986055c257188d4ea3a5b2a7912e405, type: 2}
  - {fileID: 11400000, guid: ffcb1e864dc503b4b81f4521a1c2b4e7, type: 2}
  - {fileID: 11400000, guid: 6345c6355735bcc4baa7ba93b1f06d91, type: 2}
  - {fileID: 11400000, guid: 98bb51a0686d2514d9add405a6fd8f87, type: 2}
  - {fileID: 11400000, guid: 6a8953f83823e4742ade2917aa3ead0c, type: 2}
  - {fileID: 11400000, guid: 5748efee1b47e7e4abe7820a490ea455, type: 2}
